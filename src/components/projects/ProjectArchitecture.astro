---
import type { Project } from '../../types/resume';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const diagrams: Record<string, { label: string; note: string; nodes: string[] }> = {
  'whistle-platform': {
    label: 'REAL-TIME AUDIO / VIDEO PIPELINE',
    note: '从设备采集到识别、预览和证据输出的实时处理链路。',
    nodes: ['音频 / 视频设备', '接收 · 解码 · 同步', '识别 · 定位 · 取证', 'Qt/QML 工作台', 'Web 管理 / 证据输出']
  },
  'acoustic-camera-platform': {
    label: 'ACOUSTIC IMAGING WORKFLOW',
    note: '声学数据、摄像头和设备控制在同一套桌面工作流中协同。',
    nodes: ['麦克风 / 红外 / PTZ', '采集与设备通信', '声源图 · 频谱 · PRPD', 'Qt/QML 可视化', '报告 / 校准 / 运维']
  },
  'focusound-screen-electron': {
    label: 'ELECTRON DEVICE CONTROL LOOP',
    note: '浏览器 UI、Electron 主进程和串口设备之间的边界与消息流。',
    nodes: ['React 控制面板', 'Preload / IPC', 'SerialPort · CRC16', '设备状态与重试', '角度 / 增益 / 音频输出']
  },
  'dance-device-platform': {
    label: 'MULTI-END DEVICE PLATFORM',
    note: '预约业务、设备占用和端侧控制通过服务端形成闭环。',
    nodes: ['Web / 小程序', 'Go API · 会话状态', 'MySQL · 预约数据', 'Android Device Owner', 'ADB 探测 / 锁定 / 升级']
  },
  'audfly-recording-agent': {
    label: 'WINDOWS AGENT DELIVERY LOOP',
    note: '桌面客户端将运行配置、授权检查、日志和版本交付串联起来。',
    nodes: ['WPF UI', 'MVVM / 配置服务', '录音代理与状态检查', '授权 / 日志 / 国际化', 'Velopack 自动更新']
  },
  'ac-viewer-analysis': {
    label: 'DATA PACKAGE ANALYSIS PIPELINE',
    note: '把声像仪导出的数据包转换为可分析、可视化、可导出的结果。',
    nodes: ['音频 / 视频数据包', '解析 · 校验 · 导入', '频谱 · PRPD · 声源图', 'Qt 分析工作台', '报告与数据包导出']
  },
  'acms-device-management': {
    label: 'DEVICE MANAGEMENT CONSOLE',
    note: 'Web 管理端通过 API 连接设备配置、用户和业务开关。',
    nodes: ['React / Ant Design', 'OpenAPI 类型与请求', '设备 / 用户 / 配置', '语言与声纹开关', '测试 · 构建 · 发布']
  },
  'acms-standalone-console': {
    label: 'STANDALONE DEVICE CONSOLE',
    note: '面向单机部署的声像仪配置、校准、回放和 PTZ 控制工作台。',
    nodes: ['设备状态', 'OpenAPI / MQTT', '配置与校准', 'PTZ / 回放', '升级 / 国际化']
  },
  'focusound-demonstration-app': {
    label: 'DEMONSTRATION CONTENT LOOP',
    note: '演示素材管理、表单校验和播放入口集中在桌面端完成。',
    nodes: ['视频素材库', 'Electron 文件层', 'UmiJS / React 页面', 'Ant Design 表单', '分类 · 播放 · 刷新']
  },
  'focusound-production-test': {
    label: 'PRODUCTION TESTING PIPELINE',
    note: '把仪器控制、设备协议和测试判定组织成可重复的产线流程。',
    nodes: ['测试治具 / 设备', '串口 · VISA · Audiobus', '测试编排服务', '参数采集与判定', '报告 / 更新 / 发布']
  },
  'audio-broadcast-service': {
    label: 'AUDIO BROADCAST SERVICE',
    note: '通过 HTTP/TCP 接口统一承载 TTS、音频推送、音量和声光电控制。',
    nodes: ['HTTP / TCP 请求', '协议解析与会话', 'TTS / 音频引擎', '终端播放控制', 'Web 管理 / 日志']
  },
  'scada-graphic-configuration': {
    label: 'SCADA GRAPHIC AUTHORING FLOW',
    note: '属性模型驱动图元编辑，再进入工业监控界面组态流程。',
    nodes: ['监控对象模型', '属性子系统', 'Qt Graphics 图元', '画布编辑与交互', '监控界面组态']
  },
  'qixuntong-desktop-client': {
    label: 'DESKTOP COMMUNICATION TOOLKIT',
    note: '即时通讯能力向文件、图片和桌面效率工具延展。',
    nodes: ['TCP/IP 通信', 'Qt 客户端框架', '消息与文件管理', '截图 / 图片 / 文件', 'SQLite / MySQL']
  },
  'wujiang-smart-campus': {
    label: 'CAMPUS MESSAGING WORKFLOW',
    note: '基于即时通讯基础设施承载校园业务和应急消息。',
    nodes: ['即时通讯基础', '班级管理', '事务管理', '应急消息', 'Qt PC 客户端']
  },
  'dream-editor': {
    label: 'EDITOR REFACTORING LOOP',
    note: '围绕图书制作流程持续重构编辑器模块和交互体验。',
    nodes: ['图书制作流程', 'Qt 编辑器模块', '定制版本适配', '代码重构与优化', '稳定性 / 易用性']
  },
  'ar-sdk-recognition-tracking': {
    label: 'VISION RECOGNITION LOOP',
    note: '通过输入预处理和特征参数调整改善识别与跟踪效果。',
    nodes: ['采集图像', '预处理', 'ORB 特征提取', '匹配与跟踪', '图书页识别']
  },
  'audfly-cpp-foundation': {
    label: 'C++ AUDIO FOUNDATION',
    note: '以线程安全队列、环形缓冲和计时工具支撑实时音频模块复用。',
    nodes: ['音频生产者', '线程安全队列', '环形缓冲', '处理模块', '测试 / CMake / 包']
  },
  codeharbor: {
    label: 'AI CLI ORCHESTRATION',
    note: '消息入口、任务编排和多个 AI CLI 后端之间的状态流转。',
    nodes: ['Matrix Room', 'Channel Adapter', 'Orchestrator', 'CLI Executor', 'SQLite StateStore']
  },
  plover: {
    label: 'PLAN / EXECUTE / REVIEW',
    note: '把 GUI 自动化拆成可审查、可修复、可回放的计划。',
    nodes: ['Planner', 'Versioned Plan', 'Executor', '运行时间线', '人工审核 / 修复']
  },
  bookwise: {
    label: 'BOOK TO LEARNING CONTENT',
    note: '从文件解析到章节任务和学习内容生成的处理链路。',
    nodes: ['PDF / EPUB / Markdown', '文本与章节抽取', '章节任务', 'AI / 启发式生成', '学习内容查看']
  },
  sharepier: {
    label: 'FILE UPLOAD / SHARE PIPELINE',
    note: '上传会话、对象存储和分享策略共同组成文件交付链路。',
    nodes: ['Web / API', '普通或分片上传', 'Local / S3 Storage', '分享策略', '审计与清理']
  },
  'codex-history-viewer': {
    label: 'LOCAL HISTORY SYNC',
    note: '本地会话读取、检索和跨设备增量同步的客户端链路。',
    nodes: ['SQLite / JSONL', 'Rust Data Layer', 'Tauri UI', 'Fastify API', 'PostgreSQL Sync']
  },
  'strawberry-voice-platform': {
    label: 'EDGE VOICE DEVICE LOOP',
    note: 'Jetson 端设备接入、WebSocket 通信和部署验收流程。',
    nodes: ['Jetson / ReSpeaker', 'WebSocket Gateway', '设备 Token', '语音服务', 'Docker / Tunnel']
  },
  'todo-harbor': {
    label: 'TASK / FOCUS / HISTORY',
    note: '任务状态、周期生成和专注记录统一落到可持久化的数据模型。',
    nodes: ['Web UI', 'Express API', 'SQLite', '周期任务 / 番茄钟', '导入导出 / 审计']
  },
  'lenovo-audio-control': {
    label: 'WINDOWS AUDIO CONTROL LOOP',
    note: 'WPF 控制台、IPC/RPC 和 C++ 设备能力之间的状态闭环。',
    nodes: ['WPF 控制台', '配置 / EQ / 模式', 'RPC / IPC', 'C++ 设备层', '设备状态 / 反馈']
  },
  'af-vst-audio-engine': {
    label: 'REAL-TIME DSP PIPELINE',
    note: '音频帧经过收发、滤波、增益、混音和动态处理后输出。',
    nodes: ['Audio Frame', 'Receiver / Sender', 'FIR / IIR', 'Gain / Mix / Denoise', 'Output']
  },
  'aps-sensing-console': {
    label: 'SENSING DEVICE CONSOLE',
    note: '设备配置、统计数据和图表展示由 Vue 管理端统一组织。',
    nodes: ['Vue 页面', 'Axios API', '设备配置', '统计 / ECharts', '构建 / OSS 发布']
  },
  'aigc-engineering-lab': {
    label: 'AI ENGINEERING LEARNING LOOP',
    note: '从推理优化实验到代码检索问答，再到可运行文档和测试。',
    nodes: ['C++ Inference', 'KV Cache / Quantize', 'AST Code Chunks', 'Vector Search / RAG', 'Gradio / Benchmark']
  },
  'matrix-open-stack': {
    label: 'SELF-HOSTED MATRIX STACK',
    note: 'Homeserver、控制面、管理台和公网入口组成可运维通信栈。',
    nodes: ['Web Admin', 'Control API', 'Conduwuit', 'Audit / Snapshot', 'Docker / Tunnel']
  },
  feedflow: {
    label: 'CONTENT INGESTION / DEPLOYMENT',
    note: '内容源、解析服务、数据库和 Webhook 部署形成持续运行链路。',
    nodes: ['RSS / YouTube', 'Hono API', 'PostgreSQL', 'Webhook Deploy', 'systemd / Logs']
  },
  'linuxdo-scout': {
    label: 'CRAWL / INDEX / SEARCH',
    note: 'Discourse 内容从抓取进入 SQLite，再由 CLI 和 Web UI 检索。',
    nodes: ['Discourse', 'Crawler', 'SQLite Index', 'CLI Search', 'Web UI / Docker']
  },
  'qwen3-tts-service': {
    label: 'JETSON TTS SERVICE',
    note: 'HTTP 请求进入模型能力层，按同步或流式方式返回音频。',
    nodes: ['HTTP Client', 'FastAPI', 'Custom / Design / Clone', 'WAV / MP3 Stream', 'Jetson GPU / Cache']
  },
  'video-automation': {
    label: 'CHAPTER VIDEO PIPELINE',
    note: '声明式单集配置驱动章节静帧、视频、旁白和整集合成。',
    nodes: ['episode.json', 'Script / Chapters', 'Stills / Render', 'TTS / Mix', '2K Episode']
  },
  'fanshu-book-browser': {
    label: 'LOCAL CONTENT BROWSER',
    note: '本地内容数据经过筛选、搜索和主题渲染形成可浏览产品。',
    nodes: ['Local JSON', 'React State', 'Search / Filter', 'Book Detail', 'Theme System']
  }
};

const diagram = diagrams[project.slug] || {
  label: 'PROJECT DELIVERY FLOW',
  note: '从输入、处理到交付的项目结构草图。',
  nodes: ['Input', 'Process', 'Domain Logic', 'User Interface', 'Delivery']
};

const architectureTitle = project.slug === 'audio-broadcast-service'
  ? '服务协议与播放链路'
  : project.slug === 'af-vst-audio-engine' || project.slug === 'acoustic-camera-platform'
    ? '音频处理与算法链路'
    : project.slug === 'ar-sdk-recognition-tracking' || project.slug === 'aigc-engineering-lab'
  ? '算法路径与实验结果'
  : project.slug === 'focusound-screen-electron' || project.slug === 'dance-device-platform' || project.slug === 'lenovo-audio-control'
    ? '设备控制闭环'
    : project.slug === 'audfly-recording-agent' || project.slug === 'strawberry-voice-platform'
      ? '代理运行与发布链路'
    : project.slug === 'ac-viewer-analysis' || project.slug === 'fanshu-book-browser' || project.slug === 'video-automation'
      ? '内容处理与用户流程'
      : project.slug === 'dream-editor' || project.slug === 'scada-graphic-configuration' || project.slug === 'qixuntong-desktop-client' || project.slug === 'wujiang-smart-campus'
        ? '编辑与交互工作流'
      : project.slug === 'codeharbor' || project.slug === 'plover' || project.slug === 'sharepier' || project.slug === 'matrix-open-stack'
        ? '服务边界与部署关系'
        : '系统结构与数据流';
---

<section class="architecture-sketch" aria-label={`${project.name} 架构草图`}>
  <div class="architecture-heading">
      <div>
        <span class="section-kicker">STRUCTURE / FLOW</span>
      <h2>{architectureTitle}</h2>
      </div>
    <span class="architecture-label">{diagram.label}</span>
  </div>
  <p class="architecture-note">{diagram.note}</p>
  <div class="architecture-legend" aria-label="架构图图例">
    <span><i class="legend-signal"></i>重点链路</span>
    <span><i class="legend-node"></i>代码边界</span>
    <span><i class="legend-arrow">→</i>处理 / 控制流</span>
  </div>
  <div class="architecture-flow">
    {diagram.nodes.map((node, index) => (
      <>
        <div class="architecture-node">
          <span>0{index + 1}</span>
          <strong>{node}</strong>
        </div>
        {index < diagram.nodes.length - 1 && <div class="architecture-arrow" aria-hidden="true">→</div>}
      </>
    ))}
  </div>
  <div class="architecture-footer"><span>FLOW MODEL</span><span>基于项目代码结构整理</span></div>
</section>

<style>
  .architecture-sketch {
    position: relative;
    margin-bottom: 3rem;
    padding: 1.25rem 0 1.1rem;
    border-top: 2px solid var(--color-primary);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .architecture-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding: 0 1.25rem; }
  .architecture-heading h2 { margin: 0; font: 700 1.45rem var(--font-display); letter-spacing: -.03em; }
  .architecture-label { color: var(--color-accent); font: 500 .62rem var(--font-mono); letter-spacing: .12em; text-align: right; }
  .architecture-note { max-width: 42rem; margin: .8rem 1.25rem 1.5rem; color: var(--color-text-secondary); font-size: .84rem; line-height: 1.7; }
  .architecture-legend { display: flex; flex-wrap: wrap; gap: .75rem 1rem; margin: 0 1.25rem 1rem; color: var(--color-text-secondary); font: 500 .6rem var(--font-mono); }
  .architecture-legend span { display: inline-flex; align-items: center; gap: .35rem; }
  .architecture-legend i { display: inline-grid; place-items: center; width: .55rem; height: .55rem; font-style: normal; }
  .legend-signal { background: var(--color-accent); }
  .legend-node { border: 1px solid var(--color-border); background: var(--color-bg); }
  .legend-arrow { width: auto !important; color: var(--color-accent); font-size: .8rem; }
  .architecture-flow { display: flex; align-items: stretch; gap: 0; overflow-x: auto; padding: .25rem 1.25rem .45rem; }
  .architecture-node { flex: 1 0 9.5rem; min-height: 5.75rem; display: flex; flex-direction: column; justify-content: space-between; padding: .8rem .9rem; border: 1px solid var(--color-border); border-right: 0; background: var(--color-bg); }
  .architecture-node:last-of-type { border-right: 1px solid var(--color-border); }
  .architecture-node span { color: var(--color-accent); font: 500 .62rem var(--font-mono); }
  .architecture-node strong { max-width: 9ch; color: var(--color-text); font: 600 .9rem var(--font-display); line-height: 1.3; }
  .architecture-arrow { align-self: center; z-index: 1; width: 0; margin: 0 -.35rem; color: var(--color-accent); font: 500 1rem var(--font-mono); }
  .architecture-footer { display: flex; justify-content: space-between; gap: 1rem; margin: 1.1rem 1.25rem 0; padding-top: .7rem; border-top: 1px solid var(--color-border); color: var(--color-text-secondary); font: 500 .58rem var(--font-mono); letter-spacing: .1em; }
  @media (max-width: 640px) { .architecture-sketch { padding: 1rem 0 .9rem; } .architecture-heading { display: block; padding: 0 1rem; } .architecture-label { display: block; margin-top: .8rem; text-align: left; } .architecture-note { margin-left: 1rem; margin-right: 1rem; } .architecture-flow { padding-left: 1rem; padding-right: 1rem; } .architecture-footer { margin-left: 1rem; margin-right: 1rem; } }
</style>
