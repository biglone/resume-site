    evidence: '项目技术栈为 Go/React/Postgres，功能覆盖 resumable upload、local/S3、quotas、password/expiry/download limits 和 audit logs。',
    tradeoff: '分享便利性与安全控制存在直接冲突；策略越细，用户操作越复杂，因此必须把默认值和异常反馈设计清楚。',
    sourceRefs: ['upload session / chunk assembly', 'LocalStorage / S3 storage adapter', 'share policy / audit log']
  },
  'codex-history-viewer': {
    contribution: '构建本地 Codex 历史查看与同步工具，连接 SQLite、JSONL、Tauri UI 以及服务端增量同步。',
    decisions: ['直接读取本地 SQLite 与 session JSONL，减少对外部 CLI 输出格式的依赖。', '将项目分组、会话搜索和多来源导入放在数据层统一处理，前端只消费稳定模型。', '服务端采用增量同步而非全量上传，兼顾本地隐私和跨设备回顾。'],
    evidence: '项目包含 Tauri v2/Rust、本地 state_5.sqlite、sessions JSONL、Fastify/Postgres server sync 和 Linux ARM64 GitHub Actions 发布。',
    tradeoff: '本地优先提升隐私和离线能力，但需要处理文件锁、格式演进和多来源数据不一致。',
    sourceRefs: ['Rust/Tauri local data layer', '~/.codex/state_5.sqlite and JSONL', 'Fastify/PostgreSQL incremental sync']
  },
  'strawberry-voice-platform': {
    contribution: '围绕 Jetson/ReSpeaker 语音设备的接入、部署和验收，补齐网络异常、服务不可达和恢复场景的验证工具。',
    decisions: ['设备身份通过 Token 管理，避免只凭网络位置识别终端。', '用 WebSocket 保持语音链路，用虚拟终端和压测工具提前验证服务承载能力。', '将离线提示、回切演练和采购前自检纳入交付流程，而不是只验证 Demo happy path。'],
    evidence: '项目文档和脚本覆盖 Jetson、ReSpeaker、WebSocket、Docker、Tunnel、token、smoke test 与故障恢复演练。',
    tradeoff: '边缘设备的可靠性依赖部署环境，增加诊断和自检会提高前期工作量，但能显著降低现场定位成本。',
    sourceRefs: ['Jetson device service', 'WebSocket gateway / token', 'smoke / recovery / load tests']
  },
  'todo-harbor': {
    contribution: '完成待办、周期任务、提醒、层级任务和专注记录的产品化闭环，重点处理可撤销操作和长期数据维护。',
    decisions: ['周期任务采用下一次实例生成，不把所有未来任务一次性写入数据库。', '批量编辑和多步 Undo 需要记录操作上下文，避免用户误操作后只能手工修复。', '认证隔离、健康检查和 Docker 部署作为基础能力一起交付。'],
    evidence: '项目覆盖 Express/SQLite、recurring tasks、reminders、hierarchy、batch edit、import/export、Undo、Pomodoro、auth isolation 和 CI。',
    tradeoff: '功能丰富会增加状态组合数量，因此需要用明确的数据模型和操作历史换取可恢复性。',
    sourceRefs: ['recurring task scheduler', 'operation history / Undo', 'Pomodoro / import-export / auth boundary']
  }
};

const caseEvidence = evidence[project.slug];
---

{caseNote && (
  <section class="case-notes" aria-label={`${project.name} 项目案例说明`}>
    <div class="case-notes-heading">
      <span class="section-kicker">PROJECT NOTES</span>
      <h2>从问题到交付</h2>
    </div>
    <div class="case-notes-grid">
      <article><span>01 / CONTEXT</span><h3>项目背景</h3><p>{caseNote.context}</p></article>
      <article><span>02 / ARCHITECTURE</span><h3>系统结构</h3><p>{caseNote.architecture}</p></article>
      <article><span>03 / IMPLEMENTATION</span><h3>关键实现</h3><p>{caseNote.implementation}</p></article>
      <article><span>04 / DELIVERY</span><h3>交付关注点</h3><p>{caseNote.delivery}</p></article>
    </div>
    {caseEvidence && (
      <div class="case-evidence">
        <div class="evidence-lead">
          <span class="section-kicker">INTERVIEW EVIDENCE</span>
          <h3>把项目讲到“我做了什么”</h3>
          <p>{caseEvidence.contribution}</p>
        </div>
        <div class="evidence-grid">
          <article>
            <span>05 / DECISIONS</span>
            <h3>关键技术取舍</h3>
            <ul>{caseEvidence.decisions.map((item) => <li>{item}</li>)}</ul>
          </article>
          <article>
            <span>06 / EVIDENCE</span>
            <h3>如何验证与衡量</h3>
            <p>{caseEvidence.evidence}</p>
            <p class="tradeoff"><strong>取舍：</strong>{caseEvidence.tradeoff}</p>
          </article>
        </div>
        <div class="source-refs">
          <span>可讨论的代码入口</span>
          <div>{caseEvidence.sourceRefs.map((ref) => <code>{ref}</code>)}</div>
        </div>
      </div>
    )}
  </section>
)}

<style>
  .case-notes { margin-bottom: 2.75rem; }
  .case-notes-heading { display: flex; align-items: baseline; gap: .9rem; margin-bottom: 1.1rem; }
  .case-notes-heading h2 { margin: .35rem 0 0; font: 700 1.45rem var(--font-display); }
  .case-notes-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .case-notes-grid article { min-height: 10rem; padding: 1.15rem; border: 1px solid var(--color-border); border-left: 2px solid var(--color-primary); background: var(--color-bg-secondary); }
  .case-notes-grid article:nth-child(2n) { border-left-color: var(--color-accent); }
  .case-notes-grid span { color: var(--color-primary); font: 500 .62rem var(--font-mono); letter-spacing: .1em; }
  .case-notes-grid h3 { margin: .65rem 0 .45rem; font: 700 1rem var(--font-display); }
  .case-notes-grid p { color: var(--color-text-secondary); font-size: .84rem; line-height: 1.7; }
  .case-evidence { margin-top: .75rem; padding: 1.25rem; border: 1px solid var(--color-border); background: color-mix(in srgb, var(--color-bg-secondary), transparent 5%); }
  .evidence-lead { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 1rem; align-items: baseline; padding-bottom: 1rem; border-bottom: 1px solid var(--color-border); }
  .evidence-lead h3 { margin: 0; font: 700 1.12rem var(--font-display); }
  .evidence-lead p { grid-column: 2; margin: .5rem 0 0; color: var(--color-text-secondary); font-size: .88rem; line-height: 1.75; }
  .evidence-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin-top: .75rem; }
  .evidence-grid article { padding: 1rem; border: 1px solid var(--color-border); background: var(--color-bg); }
  .evidence-grid article > span, .source-refs > span { color: var(--color-primary); font: 500 .62rem var(--font-mono); letter-spacing: .1em; }
  .evidence-grid h3 { margin: .55rem 0 .5rem; font: 700 1rem var(--font-display); }
  .evidence-grid p, .evidence-grid li { color: var(--color-text-secondary); font-size: .82rem; line-height: 1.72; }
  .evidence-grid ul { margin: 0; padding-left: 1.1rem; }
  .evidence-grid li { margin-bottom: .4rem; }
  .tradeoff { margin-top: .85rem; padding-top: .75rem; border-top: 1px dashed var(--color-border); }
  .tradeoff strong { color: var(--color-text); }
  .source-refs { margin-top: .9rem; padding-top: .85rem; border-top: 1px solid var(--color-border); }
  .source-refs div { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .55rem; }
  .source-refs code { padding: .35rem .5rem; color: var(--color-text-secondary); border: 1px solid var(--color-border); background: var(--color-bg); font: .68rem var(--font-mono); }
  @media (max-width: 640px) { .case-notes-heading { display: block; } .case-notes-heading h2 { margin-top: .4rem; } .case-notes-grid, .evidence-grid { grid-template-columns: 1fr; } .evidence-lead { display: block; } .evidence-lead h3 { margin-top: .4rem; } .evidence-lead p { margin-top: .6rem; } .case-evidence { padding: 1rem; } }
</style>
