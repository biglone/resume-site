    verification: '验证方式包括 Vitest、Playwright、typecheck、lint、覆盖率和 NPM release；重点回归重复 Matrix 事件、/stop 取消、会话迁移、附件交付和进程退出。',
    story: '面对 Matrix 异步消息和分钟级 CLI 任务的组合，我把消息回调提升为可持久化任务状态，增加并发闸门、取消和重复事件保护，让重启、超时和附件场景可以被测试和恢复。'
  },
  plover: {
    verification: '验证入口包括 planner/executor 单元测试、浏览器 E2E、smoke test、安全恢复和人工审核流程；Mock executor 用于在没有真实桌面时验证计划状态。',
    story: 'GUI 自动化失败时最重要的是可解释和可恢复，我参与设计版本化计划、repair pending 和人工审核状态，让自动修复不会静默覆盖用户意图。'
  },
  bookwise: {
    verification: '验证对象包括 PDF/EPUB/Markdown 解析、章节任务状态、provider 切换、缓存命中、失败回退和 Docker/Cloudflare Tunnel 部署。',
    story: '长文档生成一旦中途失败，重新开始代价很高，因此我参与按章节拆分任务并加入缓存和 provider 回退，让内容生产可以增量推进而不是一次性成败。'
  },
  sharepier: {
    verification: '验证重点包括分片会话过期、断点续传、配额拦截、本地/S3 存储切换、分享密码/过期/下载次数和审计记录。',
    story: '在文件分享同时面对大文件和安全策略时，我参与把上传会话、存储后端和分享策略分层，既支持断点续传，也避免把密码和下载限制只放在前端。'
  },
  'codex-history-viewer': {
    verification: '验证覆盖本地 SQLite/JSONL 读取、项目分组、全文搜索、多来源导入、Headless CLI、服务端增量同步和 Linux ARM64 GitHub Actions 发布。',
    story: '当会话数据分散在 SQLite 和 JSONL 中时，我参与将本地读取、检索和同步拆成稳定数据层，并采用增量同步兼顾跨设备回顾与本地隐私。'
  },
  'strawberry-voice-platform': {
    verification: '验证入口包括虚拟终端、smoke test、Jetson/ReSpeaker 实机步骤、采购前自检、异常降级和回切演练，以及 Docker/Tunnel 部署检查。',
    story: '语音硬件项目不能只验证 Demo happy path，我参与把鉴权、断线、离线提示、压测和回切纳入验收，使设备不可达时仍能诊断和恢复。'
  },
  'todo-harbor': {
    verification: '验证对象包括周期任务生成、层级任务、批量编辑、JSON 导入导出、多步 Undo、番茄钟、账号隔离、健康检查和 CI。',
    story: '待办功能越多，状态组合越容易失控，我参与用操作历史支撑 Undo、用明确的数据模型处理周期任务和层级关系，并把账号隔离与部署检查作为基础能力一起交付。'
  }
};

const deepDive = deepDives[project.slug] || {
  verification: `扫描依据包括 README、${project.tags.slice(0, 4).join('、')} 配置、源码目录、测试入口和最近提交；详情页只呈现能够从仓库材料复核的技术结论。`,
  story: `可以从“${project.description}”展开，重点说明我如何识别约束、划分模块、验证结果，并把实现交付到可使用的产品或工具中。`
};

const deviceProjects = new Set([
  'focusound-screen-electron', 'dance-device-platform', 'audfly-recording-agent',
  'acms-device-management', 'acms-standalone-console', 'focusound-production-test',
  'lenovo-audio-control', 'aps-sensing-console', 'audio-broadcast-service', 'strawberry-voice-platform'
]);
const algorithmProjects = new Set([
  'acoustic-camera-platform', 'ar-sdk-recognition-tracking', 'audfly-cpp-foundation',
  'af-vst-audio-engine', 'aigc-engineering-lab'
]);
const platformProjects = new Set([
  'whistle-platform', 'acms-device-management', 'dance-device-platform', 'codeharbor',
  'plover', 'bookwise', 'sharepier', 'codex-history-viewer', 'matrix-open-stack',
  'feedflow', 'linuxdo-scout', 'qwen3-tts-service', 'todo-harbor'
]);

const presentation: Presentation = deviceProjects.has(project.slug)
  ? {
      layout: 'device',
      eyebrow: 'DEVICE / PROTOCOL / STATE',
      title: '设备边界与状态闭环',
      labels: ['设备场景', '协议与状态', '异常处理', '现场交付']
    }
  : algorithmProjects.has(project.slug)
    ? {
        layout: 'algorithm',
        eyebrow: 'ALGORITHM / BENCHMARK / EVIDENCE',
        title: '算法路径与验证证据',
        labels: ['输入与约束', '处理路径', '性能或算法重点', '实验与落地']
      }
    : platformProjects.has(project.slug)
      ? {
          layout: 'platform',
          eyebrow: 'BOUNDARY / RELIABILITY / DELIVERY',
          title: '边界、可靠性与交付',
          labels: ['业务问题', '系统边界', '可靠性设计', '交付与运维']
        }
      : {
          layout: 'product',
          eyebrow: 'PRODUCT / WORKFLOW / CRAFT',
          title: '产品流程与工程取舍',
          labels: ['用户问题', '产品结构', '关键实现', '交付关注点']
        };
---

{caseNote && (
  <section class="case-notes" aria-label={`${project.name} 项目案例说明`}>
    <div class="case-notes-heading">
      <h2>{presentation.title}</h2>
      <span class="case-notes-index">{presentation.eyebrow}</span>
    </div>
    {presentation.layout === 'device' ? (
      <div class="device-case-grid">
        <article class="case-feature"><span>{presentation.labels[0]}</span><h3>{presentation.labels[0]}</h3><p>{caseNote.context}</p></article>
        <article><span>{presentation.labels[1]}</span><h3>{presentation.labels[1]}</h3><p>{caseNote.architecture}</p></article>
        <article><span>{presentation.labels[2]}</span><h3>{presentation.labels[2]}</h3><p>{caseNote.implementation}</p></article>
        <article class="case-wide"><span>{presentation.labels[3]}</span><h3>{presentation.labels[3]}</h3><p>{caseNote.delivery}</p></article>
      </div>
    ) : presentation.layout === 'algorithm' ? (
      <div class="algorithm-case-grid">
        <article class="algorithm-hero"><span>{presentation.labels[0]}</span><h3>{presentation.labels[0]}</h3><p>{caseNote.context}</p></article>
        <article><span>{presentation.labels[1]}</span><h3>{presentation.labels[1]}</h3><p>{caseNote.architecture}</p></article>
        <article><span>{presentation.labels[2]}</span><h3>{presentation.labels[2]}</h3><p>{caseNote.implementation}</p></article>
        <article class="case-wide"><span>{presentation.labels[3]}</span><h3>{presentation.labels[3]}</h3><p>{caseNote.delivery}</p></article>
      </div>
    ) : presentation.layout === 'platform' ? (
      <div class="platform-case-grid">
        <article><span>{presentation.labels[0]}</span><h3>{presentation.labels[0]}</h3><p>{caseNote.context}</p></article>
        <article class="platform-boundary"><span>{presentation.labels[1]}</span><h3>{presentation.labels[1]}</h3><p>{caseNote.architecture}</p></article>
        <article><span>{presentation.labels[2]}</span><h3>{presentation.labels[2]}</h3><p>{caseNote.implementation}</p></article>
        <article><span>{presentation.labels[3]}</span><h3>{presentation.labels[3]}</h3><p>{caseNote.delivery}</p></article>
      </div>
    ) : (
      <div class="case-notes-grid product-case-grid">
        <article><span>{presentation.labels[0]}</span><h3>{presentation.labels[0]}</h3><p>{caseNote.context}</p></article>
        <article><span>{presentation.labels[1]}</span><h3>{presentation.labels[1]}</h3><p>{caseNote.architecture}</p></article>
        <article><span>{presentation.labels[2]}</span><h3>{presentation.labels[2]}</h3><p>{caseNote.implementation}</p></article>
        <article><span>{presentation.labels[3]}</span><h3>{presentation.labels[3]}</h3><p>{caseNote.delivery}</p></article>
      </div>
    )}
    {caseEvidence && (
      <div class="case-evidence">
        <div class="evidence-lead">
          <h3>把项目讲到“我做了什么”</h3>
          <span>个人贡献 / 证据 / 取舍</span>
          <p>{caseEvidence.contribution}</p>
        </div>
        <div class="evidence-grid">
          <article>
            <span>关键技术取舍</span>
            <h3>关键技术取舍</h3>
            <ul>{caseEvidence.decisions.map((item) => <li>{item}</li>)}</ul>
          </article>
          <article>
            <span>如何验证与衡量</span>
            <h3>如何验证与衡量</h3>
            <p>{caseEvidence.evidence}</p>
            <p class="tradeoff"><strong>取舍：</strong>{caseEvidence.tradeoff}</p>
          </article>
        </div>
        <div class="source-refs">
          <span>可讨论的代码入口</span>
          <div>{caseEvidence.sourceRefs.map((ref) => <code>{ref}</code>)}</div>
        </div>
        {deepDive && (
          <div class="deep-dive-grid">
            <article>
              <span>代码与文档证明</span>
              <h3>代码与文档如何证明</h3>
              <p>{deepDive.verification}</p>
            </article>
            <article>
              <span>面试叙事</span>
              <h3>面试表达示例</h3>
              <p>{deepDive.story}</p>
            </article>
          </div>
        )}
      </div>
    )}
  </section>
)}

<style>
  .case-notes { margin-bottom: 3.5rem; }
  .case-notes-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding-bottom: .85rem; margin-bottom: 0; border-bottom: 1px solid var(--color-text); }
  .case-notes-heading h2 { margin: 0; font: 700 clamp(1.45rem, 3vw, 2.15rem) var(--font-display); letter-spacing: -.035em; }
  .case-notes-index { color: var(--color-primary); font: 500 .62rem var(--font-mono); letter-spacing: .12em; }
  .case-notes-grid, .device-case-grid, .algorithm-case-grid, .platform-case-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; }
  .case-notes-grid article, .device-case-grid article, .algorithm-case-grid article, .platform-case-grid article { min-height: 11rem; padding: 1.35rem 0 1.5rem; border-bottom: 1px solid var(--color-border); background: transparent; }
  .case-notes-grid article:nth-child(2n), .device-case-grid article:nth-child(2n), .algorithm-case-grid article:nth-child(2n), .platform-case-grid article:nth-child(2n) { border-left: 1px solid var(--color-border); padding-left: 2rem; }
  .case-notes-grid span, .device-case-grid span, .algorithm-case-grid span, .platform-case-grid span { color: var(--color-primary); font: 500 .62rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .case-notes-grid h3, .device-case-grid h3, .algorithm-case-grid h3, .platform-case-grid h3 { margin: .8rem 0 .5rem; font: 700 1.08rem var(--font-display); }
  .case-notes-grid p, .device-case-grid p, .algorithm-case-grid p, .platform-case-grid p { max-width: 42rem; color: var(--color-text-secondary); font-size: .88rem; line-height: 1.8; }
  .device-case-grid .case-wide, .algorithm-case-grid .algorithm-hero, .algorithm-case-grid .case-wide { grid-column: 1 / -1; min-height: auto; }
  .device-case-grid .case-wide p, .algorithm-case-grid .algorithm-hero p, .algorithm-case-grid .case-wide p { max-width: 58rem; }
  .platform-case-grid { grid-template-columns: 1.15fr .85fr; }
  .platform-case-grid .platform-boundary { grid-row: span 2; min-height: 100%; padding: 1.35rem 2rem; background: var(--color-surface); border-left: 3px solid var(--color-accent); border-bottom: 0; color: var(--color-text); }
  .platform-case-grid .platform-boundary span { color: var(--color-accent); }
  .platform-case-grid .platform-boundary h3 { color: var(--color-text); font-size: 1.35rem; }
  .platform-case-grid .platform-boundary p { color: var(--color-text-secondary); }
  .case-evidence { margin-top: 2.25rem; padding-top: 1.25rem; border-top: 2px solid var(--color-primary); }
  .evidence-lead { display: grid; grid-template-columns: minmax(12rem, .55fr) minmax(0, 1.45fr); column-gap: 2rem; align-items: baseline; padding-bottom: 1.35rem; border-bottom: 1px solid var(--color-border); }
  .evidence-lead h3 { grid-column: 1; margin: 0; font: 700 1.2rem var(--font-display); }
  .evidence-lead > span { grid-column: 1; margin-top: .45rem; color: var(--color-primary); font: 500 .62rem var(--font-mono); letter-spacing: .1em; }
  .evidence-lead p { grid-column: 2; grid-row: 1 / span 2; margin: 0; color: var(--color-text-secondary); font-size: .92rem; line-height: 1.8; }
  .evidence-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; margin-top: 0; }
  .evidence-grid article { padding: 1.35rem 0; background: transparent; border-bottom: 1px solid var(--color-border); }
  .evidence-grid article:nth-child(2) { border-left: 1px solid var(--color-border); padding-left: 2rem; }
  .evidence-grid article > span, .source-refs > span, .deep-dive-grid article > span { color: var(--color-primary); font: 500 .62rem var(--font-mono); letter-spacing: .1em; text-transform: uppercase; }
  .evidence-grid h3, .deep-dive-grid h3 { margin: .65rem 0 .5rem; font: 700 1rem var(--font-display); }
  .evidence-grid p, .evidence-grid li, .deep-dive-grid p { color: var(--color-text-secondary); font-size: .84rem; line-height: 1.78; }
  .evidence-grid ul { margin: 0; padding-left: 1.1rem; }
  .evidence-grid li { margin-bottom: .45rem; }
  .tradeoff { margin-top: .9rem; padding-top: .8rem; border-top: 1px dashed var(--color-border); }
  .tradeoff strong { color: var(--color-text); }
  .source-refs { padding: 1.1rem 0; border-bottom: 1px solid var(--color-border); }
  .source-refs div { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin-top: .65rem; }
  .source-refs code { padding: 0; color: var(--color-text-secondary); background: transparent; font: .7rem var(--font-mono); }
  .source-refs code::before { content: '↳ '; color: var(--color-accent); }
  .deep-dive-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; }
  .deep-dive-grid article { padding: 1.35rem 0 0; background: transparent; }
  .deep-dive-grid article:nth-child(2) { border-left: 1px solid var(--color-border); padding-left: 2rem; }
  @media (max-width: 640px) { .case-notes-heading { display: block; } .case-notes-heading h2 { margin-bottom: .55rem; } .case-notes-grid, .device-case-grid, .algorithm-case-grid, .platform-case-grid, .evidence-grid, .deep-dive-grid { grid-template-columns: 1fr; } .case-notes-grid article:nth-child(2n), .device-case-grid article:nth-child(2n), .algorithm-case-grid article:nth-child(2n), .platform-case-grid article:nth-child(2n), .evidence-grid article:nth-child(2), .deep-dive-grid article:nth-child(2) { border-left: 0; padding-left: 0; } .device-case-grid .case-wide, .algorithm-case-grid .algorithm-hero, .algorithm-case-grid .case-wide { grid-column: auto; } .platform-case-grid { display: block; } .platform-case-grid .platform-boundary { min-height: auto; margin: 1rem 0; padding: 1.2rem 0; background: transparent; color: inherit; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); } .platform-case-grid .platform-boundary h3 { color: var(--color-text); } .platform-case-grid .platform-boundary p { color: var(--color-text-secondary); } .platform-case-grid .platform-boundary span { color: var(--color-primary); } .evidence-lead { display: block; } .evidence-lead h3 { margin-bottom: .45rem; } .evidence-lead p { margin-top: .8rem; } }
</style>
