---
import type { Project } from '../../types/resume';

interface CaseNote {
  context: string;
  architecture: string;
  implementation: string;
  delivery: string;
}

interface CaseEvidence {
  contribution: string;
  decisions: string[];
  evidence: string;
  tradeoff: string;
  sourceRefs: string[];
}

interface DeepDive {
  verification: string;
  story: string;
}

interface Presentation {
  layout: 'pipeline' | 'device' | 'algorithm' | 'platform' | 'product';
  eyebrow: string;
  title: string;
  labels: [string, string, string, string];
}

interface Props { project: Project; }
