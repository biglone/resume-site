---
import type { Project } from '../types/resume';

interface Props { projects: Project[]; }
const { projects } = Astro.props;
const company  = projects.filter((p) => p.category === 'company');
const personal = projects.filter((p) => p.category === 'personal');
const total = company.length + personal.length;

const pillars = [
  {
    icon: '⌨',
    label: '桌面与设备',
    claim: '写能在客户现场稳定运行的代码',
    stack: 'C++ · Qt · WPF · Electron',
  },
  {
    icon: '◎',
    label: '音频与视觉',
    claim: '让声音和图像在软件里有正确的时间戳',
    stack: 'OpenCV · FFmpeg · DSP · TTS',
  },
  {
    icon: '⚡',
    label: '智能与服务',
    claim: '把 AI 工具接入真实的工程链路',
    stack: 'Agent · FastAPI · Go · Node.js',
  },
  {
    icon: '◻',
    label: '交付与质量',
    claim: '从构建脚本到 CI，让交付可重复',
    stack: 'Docker · CI/CD · E2E · Jetson',
  },
];
---

<section class="overview-section" aria-labelledby="overview-title">
  <div class="section-container">

    <!-- Heading row -->
    <div class="overview-top">
      <div class="overview-lead">
        <span class="section-kicker">SELECTED WORK</span>
        <h2 id="overview-title" class="section-title overview-headline">
          把复杂的系统，做成可理解的产品。
        </h2>
      </div>
      <p class="overview-note">
        我关心的不只是功能是否完成，也关心一套复杂技术如何被使用、被解释，以及最终如何稳定地交到别人手里。
      </p>
    </div>

    <!-- Stats row -->
    <div class="overview-stats">
      <div class="stat-item">
        <strong>{total}</strong>
        <span>代表性项目</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <strong>{company.length}</strong>
        <span>公司项目</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-item">
        <strong>{personal.length}</strong>
        <span>个人项目</span>
      </div>
    </div>

    <!-- Pillars -->
    <div class="pillars">
      {pillars.map((p, i) => (
        <div class="pillar animate-fade-in-up" style={`animation-delay:${i * 0.07}s`}>
          <span class="pillar-icon" aria-hidden="true">{p.icon}</span>
          <div>
            <p class="pillar-label">{p.label}</p>
            <p class="pillar-claim">{p.claim}</p>
            <p class="pillar-stack">{p.stack}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .overview-section {
    padding: 5rem 0 2.5rem;
    background: var(--color-bg);
  }

  /* Top heading */
  .overview-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .overview-headline {
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    max-width: 22ch;
    line-height: 1.2;
  }

  .overview-note {
    max-width: 26rem;
    color: var(--color-text-muted);
    font-size: .9rem;
    line-height: 1.8;
  }

  /* Stats */
  .overview-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: .2rem;
  }

  .stat-item strong {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 700;
    letter-spacing: -.06em;
    color: var(--color-accent);
    line-height: 1;
  }

  .stat-item span {
    font-size: .75rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    letter-spacing: .05em;
  }

  .stat-divider {
    width: 1px;
    height: 3rem;
    background: var(--color-border);
    align-self: center;
  }

  /* Pillars */
  .pillars {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: .65rem;
    padding: 1.5rem;
    background: var(--color-surface);
    transition: background-color 0.2s ease;
  }

  .pillar:hover {
    background: var(--color-accent-soft);
  }

  .pillar-icon {
    font-size: 1.1rem;
    color: var(--color-accent);
    line-height: 1;
  }

  .pillar-label {
    font-family: var(--font-mono);
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .pillar-claim {
    font-size: .88rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.5;
    margin: 0;
  }

  .pillar-stack {
    font-family: var(--font-mono);
    font-size: .68rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 860px) {
    .pillars { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .overview-top { flex-direction: column; align-items: flex-start; }
    .pillars { grid-template-columns: 1fr; }
    .stat-divider { display: none; }
  }
</style>
