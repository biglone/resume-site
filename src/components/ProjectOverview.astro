---
import type { Project } from '../types/resume';

interface Props { projects: Project[]; }
const { projects } = Astro.props;
const company = projects.filter((project) => project.category === 'company');
const personal = projects.filter((project) => project.category === 'personal');
const total = company.length + personal.length;
const lanes = [
  { label: '桌面与设备', value: 'C++ · Qt · Electron · WPF', color: 'var(--color-primary)' },
  { label: '音频与视觉', value: 'OpenCV · FFmpeg · TTS · Web Audio', color: 'var(--color-accent)' },
  { label: '智能与服务', value: 'Agent · FastAPI · Go · Node.js', color: 'var(--color-warm)' },
  { label: '交付与质量', value: 'Docker · CI/CD · E2E · Jetson', color: 'var(--color-sage)' },
];
---

<section class="project-overview" aria-labelledby="project-map-title">
  <div class="section-container">
    <div class="overview-heading">
      <div>
        <p class="eyebrow">项目方法</p>
        <h2 id="project-map-title" class="section-title">把复杂的系统，做成可理解的产品。</h2>
      </div>
      <p class="overview-note">我关心的不只是功能是否完成，也关心一套复杂的技术如何被使用、被解释，以及最后如何稳定地交到别人手里。</p>
    </div>

    <div class="overview-editorial">
      <aside class="overview-count">
        <strong>{total}</strong>
        <span>个被认真做过的项目</span>
        <small>{company.length} 个工作项目 · {personal.length} 个个人项目</small>
      </aside>
      <div class="method-list">
        {lanes.map((lane) => (
          <div class="method-item">
            <span>{lane.label}</span>
            <p>{lane.value}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .project-overview { padding: 5rem 0 1rem; background: var(--color-bg); }
  .overview-heading { display: flex; justify-content: space-between; gap: 2rem; align-items: end; margin-bottom: 2rem; }
  .overview-heading .section-title { margin-bottom: 0; border: 0; padding: 0; max-width: 34rem; }
  .eyebrow, .signal-label, .lane-index { font-family: var(--font-mono); letter-spacing: .14em; text-transform: uppercase; font-size: .68rem; color: var(--color-text-secondary); }
  .eyebrow { color: var(--color-primary); margin-bottom: .65rem; }
  .overview-note { max-width: 25rem; color: var(--color-text-secondary); line-height: 1.7; font-size: .9rem; }
  .overview-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 1rem; }
  .signal-card { min-height: 10rem; padding: 1.4rem; border: 1px solid var(--color-border); background: var(--color-bg-secondary); border-radius: 1rem; }
  .signal-card-main { background: var(--color-surface); color: var(--color-text); border: 1px solid var(--color-border); box-shadow: inset 3px 0 0 var(--color-accent); }
  .signal-card-main .signal-label, .signal-card-main > span:not(.signal-label) { color: var(--color-text-secondary); }
  .signal-card strong { display: block; font-family: var(--font-display); font-size: 3.6rem; line-height: 1; margin: .6rem 0 .25rem; }
  .scope-bars { display: flex; height: .4rem; margin-top: 1.2rem; border-radius: 1rem; overflow: hidden; background: var(--color-border); }
  .scope-bars div:first-child { background: var(--color-primary); }
  .scope-bars div:last-child { background: var(--color-accent); }
  .scope-legend { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: .75rem; font-size: .72rem; color: var(--color-text-secondary); }
  .scope-legend i { display: inline-block; width: .45rem; height: .45rem; border-radius: 50%; margin-right: .35rem; }
  .legend-company { background: var(--color-primary); }
  .legend-personal { background: var(--color-accent); }
  .delivery-flow { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; margin: 1.25rem 0 .8rem; font-family: var(--font-mono); font-size: .74rem; }
  .delivery-flow span { padding: .45rem .6rem; color: var(--color-primary); border: 1px solid color-mix(in srgb, var(--color-primary), transparent 65%); border-radius: .45rem; }
  .delivery-flow b { color: var(--color-text-secondary); font-weight: 400; }
  .signal-card p { color: var(--color-text-secondary); line-height: 1.6; font-size: .84rem; margin: 0; }
  .lane-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; margin-top: .75rem; }
  .lane { display: flex; gap: .8rem; align-items: flex-start; padding: 1rem; border-top: 2px solid var(--lane-color); background: var(--color-bg-secondary); animation: fadeInUp .55s ease both; animation-delay: var(--lane-delay); }
  .lane-index { color: var(--lane-color); }
  .lane strong { font-size: .85rem; }
  .lane p { color: var(--color-text-secondary); font-size: .72rem; line-height: 1.5; margin-top: .35rem; }
  @media (max-width: 760px) { .overview-heading { display: block; } .overview-note { margin-top: 1rem; } .overview-grid, .lane-grid { grid-template-columns: 1fr; } }

  .overview-editorial { display: grid; grid-template-columns: .75fr 1.25fr; gap: 5rem; margin-top: 3.5rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border); }
  .overview-count { display: flex; flex-direction: column; align-items: flex-start; }
  .overview-count strong { color: var(--color-accent); font: 400 clamp(5rem, 11vw, 9rem)/.72 var(--font-display); letter-spacing: -.07em; }
  .overview-count span { margin-top: 1.2rem; font-family: var(--font-display); font-size: 1.35rem; }
  .overview-count small { margin-top: .7rem; color: var(--color-text-secondary); font-size: .75rem; }
  .method-list { border-top: 1px solid var(--color-text); }
  .method-item { display: grid; grid-template-columns: 10rem 1fr; gap: 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border); }
  .method-item span { color: var(--color-text-secondary); font: 500 .75rem var(--font-body); }
  .method-item p { margin: 0; color: var(--color-text); font-size: .95rem; line-height: 1.6; }
  @media (max-width: 760px) { .overview-editorial { grid-template-columns: 1fr; gap: 2.5rem; margin-top: 2.5rem; } .method-item { grid-template-columns: 7rem 1fr; gap: 1rem; } }
</style>
