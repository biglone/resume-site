---
import type { Project } from '../types/resume';
import Badge from './common/Badge.astro';

interface Props { projects: Project[]; }
const { projects } = Astro.props;
const groups = [
  { title: '公司项目', note: '按任职时间从新到旧', items: projects.filter((project) => project.category === 'company').sort((a, b) => (b.period || '').localeCompare(a.period || '')) },
  { title: '个人项目', note: '实验、工具与产品', items: projects.filter((project) => project.category === 'personal') },
];
const filters = [
  { label: '全部项目', value: 'all' },
  { label: '公司项目', value: 'company' },
  { label: '个人项目', value: 'personal' },
  { label: 'C++ / Qt', value: 'cpp-qt' },
  { label: '音频 / 视觉', value: 'audio-vision' },
  { label: 'Electron / Web', value: 'electron-web' },
  { label: 'AI / 工具链', value: 'ai-tools' },
];
const companyFilters = Array.from(new Set(
  projects
    .filter((project) => project.category === 'company' && project.employer)
    .map((project) => project.employer as string),
));
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<section id="projects" class="projects-section">
  <div class="section-container">
    <div class="section-intro">
      <div><p class="eyebrow">SELECTED PROJECTS</p><h2 class="section-title">项目经历</h2></div>
      <p>从设备接入、实时音视频到 Web 全栈与智能工具，展示代表性项目中的职责、方案与交付结果。</p>
    </div>

    <div class="project-filters" aria-label="项目筛选">
      <span class="filter-label">FILTER /</span>
      {filters.map((filter, index) => (
        <button type="button" class:list={['filter-button', index === 0 && 'is-active']} data-filter={filter.value} aria-pressed={index === 0 ? 'true' : 'false'}>{filter.label}</button>
      ))}
      {companyFilters.length > 0 && (
        <div class="company-filter">
          <span>任职公司</span>
          <details class="company-menu">
            <summary class="company-trigger" aria-label="按任职公司筛选项目"><span data-company-label>全部公司</span><b aria-hidden="true">⌄</b></summary>
            <div class="company-options" role="listbox" aria-label="任职公司选项">
              <button type="button" class="company-option is-selected" data-employer="" role="option" aria-selected="true">全部公司</button>
              {companyFilters.map((company) => <button type="button" class="company-option" data-employer={company} role="option" aria-selected="false">{company}</button>)}
            </div>
          </details>
        </div>
      )}
      <span class="filter-result" aria-live="polite"></span>
    </div>

    <div class="project-columns">
      {groups.map((group) => (
        <div class="project-group" data-project-group>
          <div class="group-heading"><h3>{group.title}</h3><span>{group.note} · <b data-group-count>{group.items.length}</b> 项</span></div>
          <div class="project-grid">
            {group.items.map((project, index) => (
              <details class:list={['project-entry', project.featured && 'project-entry-featured']} name="project-accordion" data-category={project.category} data-employer={project.employer || ''} data-tags={project.tags.join('|').toLowerCase()}>
                <summary class="project-summary">
                  <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
                  <span class="project-summary-main">
                    <strong>{project.name}</strong>
                    <span>{project.employer || '个人项目'}</span>
                    <small>{project.role} · {project.period}</small>
                  </span>
                  <span class="summary-toggle" aria-hidden="true">展开 <b>＋</b></span>
                </summary>
                <div class="project-entry-body">
                  <div class="entry-links">
                    {project.link && <a href={project.link} target="_blank" rel="noopener noreferrer" aria-label={'查看 ' + project.name + ' 源码'}>GitHub ↗</a>}
                    <a href={baseUrl + 'projects/' + project.slug} aria-label={'查看 ' + project.name + ' 详情'}>查看详情 ↗</a>
                  </div>
                  <p class="project-description">{project.description}</p>
                  <ul class="highlight-list">{project.highlights.slice(0, 3).map((highlight) => <li>{highlight}</li>)}</ul>
                  {project.metrics && <div class="metric-row">{project.metrics.map((metric) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>}
                  <div class="tag-row">
                    <span class="tag-label">STACK</span>
                    {project.tags.slice(0, 6).map((tag) => <Badge text={tag} variant="outline" />)}
                    {project.tags.length > 6 && <span class="more-tags">+{project.tags.length - 6}</span>}
                  </div>
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const projectEntries = document.querySelectorAll<HTMLDetailsElement>('details.project-entry');
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
  const companyMenu = document.querySelector<HTMLDetailsElement>('.company-menu');
  const companyLabel = document.querySelector<HTMLElement>('[data-company-label]');
  const companyOptions = document.querySelectorAll<HTMLButtonElement>('.company-option');
  const projectGroups = document.querySelectorAll<HTMLElement>('[data-project-group]');
  const filterResult = document.querySelector<HTMLElement>('.filter-result');

  projectEntries.forEach((entry) => {
    entry.addEventListener('toggle', () => {
      if (!entry.open) return;
      projectEntries.forEach((other) => {
        if (other !== entry) other.open = false;
      });
    });
  });

  const filterTerms: Record<string, string[]> = {
    'cpp-qt': ['c++', 'qt', 'c++17', 'c++14', 'c++11'],
    'audio-vision': ['opencv', 'ffmpeg', '音频', '音视频', 'dsp', 'fir/iir', '降噪', '混音', 'prpd', '频谱', '声学', 'tts'],
    'electron-web': ['electron', 'react', 'typescript', 'node.js', 'next.js', 'vue', 'umijs', 'websocket'],
    'ai-tools': ['ai', 'python', 'fastapi', 'codex cli', 'rag', 'gradio', 'sherpa-onnx', 'tts']
  };

  const applyFilter = (value: string, employerFilter = '') => {
    let visibleCount = 0;
    projectEntries.forEach((entry) => {
      const category = entry.dataset.category || '';
      const employer = entry.dataset.employer || '';
      const tags = entry.dataset.tags || '';
      const matches = value === 'all'
        || category === value
        || (employerFilter !== '' && employer === employerFilter)
        || (filterTerms[value] || []).some((term) => tags.includes(term));
      entry.hidden = !matches;
      if (!matches) entry.open = false;
      if (matches) visibleCount += 1;
    });
    projectGroups.forEach((group) => {
      const entries = Array.from(group.querySelectorAll<HTMLDetailsElement>('.project-entry'));
      const visibleEntries = entries.filter((entry) => !entry.hidden);
      group.hidden = visibleEntries.length === 0;
      const count = group.querySelector<HTMLElement>('[data-group-count]');
      if (count) count.textContent = String(visibleEntries.length);
      visibleEntries.forEach((entry, index) => {
        const number = entry.querySelector<HTMLElement>('.project-number');
        if (number) number.textContent = String(index + 1).padStart(2, '0');
      });
    });
    filterButtons.forEach((button) => {
      const active = button.dataset.filter === value;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    if (filterResult) filterResult.textContent = `${visibleCount} 项`;
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      companyOptions.forEach((option) => {
        const selected = option.dataset.employer === '';
        option.classList.toggle('is-selected', selected);
        option.setAttribute('aria-selected', String(selected));
      });
      if (companyLabel) companyLabel.textContent = '全部公司';
      if (companyMenu) companyMenu.open = false;
      applyFilter(button.dataset.filter || 'all');
    });
  });
  companyOptions.forEach((option) => {
    option.addEventListener('click', () => {
      const employer = option.dataset.employer || '';
      companyOptions.forEach((item) => {
        const selected = item === option;
        item.classList.toggle('is-selected', selected);
        item.setAttribute('aria-selected', String(selected));
      });
      if (companyLabel) companyLabel.textContent = option.textContent || '全部公司';
      if (companyMenu) companyMenu.open = false;
      applyFilter('company-filter', employer);
    });
  });
  applyFilter('all');
</script>

<style>
  .projects-section { padding: 5rem 0; background: var(--color-bg-secondary); }
  .section-intro { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 3rem; }
  .section-intro .section-title { margin-bottom: 0; border: 0; padding: 0; }
  .section-intro > p { max-width: 27rem; color: var(--color-text-secondary); line-height: 1.7; font-size: .9rem; }
  .eyebrow { font-family: var(--font-mono); color: var(--color-primary); letter-spacing: .14em; text-transform: uppercase; font-size: .68rem; margin-bottom: .65rem; }
  .project-filters { display: flex; align-items: center; flex-wrap: wrap; gap: .45rem .7rem; margin: 0 0 2.25rem; padding: .8rem 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .filter-label { margin-right: .25rem; color: var(--color-accent); font: 500 .62rem var(--font-mono); letter-spacing: .12em; }
  .filter-button { padding: .42rem .6rem; border: 1px solid transparent; background: transparent; color: var(--color-text-secondary); cursor: pointer; font: 500 .68rem var(--font-mono); transition: border-color .2s ease, color .2s ease, background-color .2s ease; }
  .filter-button:hover, .filter-button:focus-visible { border-color: var(--color-accent); color: var(--color-primary); outline: none; }
  .filter-button.is-active { border-color: var(--color-primary); background: var(--color-primary); color: var(--color-bg); }
  .company-filter { position: relative; display: inline-flex; align-items: center; gap: .5rem; margin-left: .35rem; color: var(--color-text-secondary); font: 500 .64rem var(--font-mono); }
  .company-menu { position: relative; min-width: 13rem; }
  .company-trigger { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .42rem .6rem; border: 1px solid var(--color-border); color: var(--color-text); cursor: pointer; font: 500 .68rem var(--font-mono); list-style: none; }
  .company-trigger::-webkit-details-marker { display: none; }
  .company-trigger::after { content: ''; position: absolute; inset: 0; border: 1px solid transparent; pointer-events: none; }
  .company-trigger:hover, .company-menu[open] .company-trigger { border-color: var(--color-accent); color: var(--color-primary); }
  .company-trigger:focus-visible { outline: 2px solid color-mix(in srgb, var(--color-accent) 30%, transparent); outline-offset: 2px; }
  .company-trigger b { color: var(--color-accent); font-size: .9rem; font-weight: 500; line-height: .7; transition: transform .2s ease; }
  .company-menu[open] .company-trigger b { transform: rotate(180deg); }
  .company-options { position: absolute; z-index: 10; top: calc(100% + .35rem); right: 0; left: 0; display: grid; gap: .15rem; padding: .35rem; border: 1px solid var(--color-border); background: var(--color-bg-secondary); box-shadow: 0 .8rem 1.8rem color-mix(in srgb, var(--color-text) 14%, transparent); }
  .company-option { display: block; width: 100%; padding: .5rem .55rem; border: 0; background: transparent; color: var(--color-text-secondary); cursor: pointer; text-align: left; font: 500 .68rem var(--font-mono); }
  .company-option:hover, .company-option:focus-visible, .company-option.is-selected { background: var(--color-primary); color: var(--color-bg); outline: none; }
  .filter-result { margin-left: auto; color: var(--color-text-secondary); font: 500 .64rem var(--font-mono); }
  .project-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3.5rem; align-items: start; }
  .project-columns > .project-group + .project-group { margin-top: 0; }
  .project-group { min-width: 0; }
  .group-heading { display: flex; align-items: baseline; gap: .8rem; border-bottom: 2px solid var(--color-primary); padding-bottom: .8rem; margin-bottom: 0; }
  .group-heading h3 { font: 650 1.25rem var(--font-display); color: var(--color-text); }
  .group-heading span { color: var(--color-text-secondary); font-size: .72rem; }
  .project-grid { display: block; }
  .project-entry { border-bottom: 1px solid var(--color-border); }
  .project-entry[hidden], .project-group[hidden] { display: none; }
  .project-entry[open] { border-bottom-color: var(--color-primary); }
  .project-summary { position: relative; display: grid; grid-template-columns: 2.25rem minmax(0, 1fr) auto; gap: .8rem; align-items: center; min-height: 6.5rem; padding: 1.1rem 0; cursor: pointer; list-style: none; }
  .project-summary::-webkit-details-marker { display: none; }
  .project-summary::after { content: ''; position: absolute; inset: 0 auto 0 -.8rem; width: 3px; background: var(--color-accent); transform: scaleY(0); transition: transform .2s ease; }
  .project-summary:hover::after, .project-entry[open] .project-summary::after { transform: scaleY(1); }
  .project-number { align-self: start; padding-top: .15rem; color: var(--color-accent); font: 500 .78rem var(--font-mono); letter-spacing: .08em; }
  .project-summary-main { min-width: 0; display: grid; gap: .28rem; }
  .project-summary-main strong { color: var(--color-text); font: 600 1.02rem var(--font-display); line-height: 1.25; }
  .project-summary-main span { overflow: hidden; color: var(--color-text-secondary); font: 500 .68rem var(--font-mono); text-overflow: ellipsis; white-space: nowrap; }
  .project-summary-main small { color: var(--color-primary); font: 500 .66rem var(--font-mono); }
  .summary-toggle { display: flex; align-items: center; gap: .35rem; color: var(--color-text-secondary); font: 500 .62rem var(--font-mono); white-space: nowrap; }
  .summary-toggle b { color: var(--color-accent); font-size: 1rem; font-weight: 400; transition: transform .2s ease; }
  .project-entry[open] .summary-toggle b { transform: rotate(45deg); }
  .project-entry[open] .summary-toggle { color: var(--color-accent); }
  .project-entry-body { padding: 0 0 1.5rem 3.05rem; animation: projectReveal .22s ease both; }
  .entry-links { display: flex; flex-wrap: wrap; gap: .8rem; margin-bottom: 1rem; }
  .entry-links a { padding-bottom: .2rem; border-bottom: 1px solid var(--color-border); color: var(--color-primary); font: 500 .68rem var(--font-mono); text-decoration: none; }
  .entry-links a:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .project-description { margin: 0 0 1rem; color: var(--color-text-secondary); font-size: .86rem; line-height: 1.7; }
  .highlight-list { display: grid; gap: .5rem; margin: 0 0 1.1rem; color: var(--color-text-secondary); font-size: .78rem; line-height: 1.55; }
  .highlight-list li { position: relative; padding-left: .9rem; }
  .highlight-list li::before { content: ''; position: absolute; top: .58em; left: 0; width: .3rem; height: .3rem; background: var(--color-accent); }
  .metric-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; padding: .75rem 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); margin-bottom: 1rem; }
  .metric-row div { min-width: 0; }
  .metric-row strong { display: block; color: var(--color-text); font: 600 .78rem var(--font-mono); line-height: 1.35; overflow-wrap: anywhere; }
  .metric-row span { display: block; margin-top: .25rem; color: var(--color-text-secondary); font-size: .62rem; }
  .tag-row { display: flex; flex-wrap: wrap; gap: .35rem .55rem; align-items: center; }
  .tag-label { margin-right: .2rem; color: var(--color-accent); font: 500 .6rem var(--font-mono); letter-spacing: .08em; }
  .badge-outline { border: 0; padding: 0; color: var(--color-text-secondary) !important; background: transparent; font-size: .7rem; }
  .more-tags { color: var(--color-text-secondary); font-size: .68rem; }
  @keyframes projectReveal { from { opacity: 0; transform: translateY(-.35rem); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) { .project-entry-body, .summary-toggle b, .project-summary::after { animation: none; transition: none; } }
  @media (max-width: 860px) { .project-columns { gap: 2rem; } .project-summary { grid-template-columns: 2rem minmax(0, 1fr); } .summary-toggle { grid-column: 2; } }
  @media (max-width: 640px) { .section-intro { display: block; } .section-intro > p { margin-top: 1rem; } .project-filters { align-items: flex-start; } .filter-label { width: 100%; } .company-filter { width: 100%; margin-left: 0; justify-content: space-between; } .company-menu { flex: 1; } .company-options { right: 0; } .filter-result { margin-left: 0; width: 100%; } .project-columns { display: block; } .project-columns > .project-group + .project-group { margin-top: 3.5rem; } .project-summary { min-height: 6rem; } .project-entry-body { padding-left: 2.8rem; } }
</style>
