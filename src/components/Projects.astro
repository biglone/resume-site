---
import type { Project } from '../types/resume';
import Badge from './common/Badge.astro';

interface Props { projects: Project[]; }
const { projects } = Astro.props;
const getPeriodEdge = (period = '', edge: 'start' | 'end') => {
  if (edge === 'end' && /(至今|现在|present|current)/i.test(period)) return Number.MAX_SAFE_INTEGER;
  const matches = [...period.matchAll(/(\d{4})(?:\.(\d{1,2}))?/g)];
  if (matches.length === 0) return 0;
  const match = edge === 'start' ? matches[0] : matches[matches.length - 1];
  const year = Number(match[1]);
  const month = match[2] ? Number(match[2]) : edge === 'end' ? 12 : 1;
  return year * 12 + month;
};
const compareProjectPeriods = (a: Project, b: Project) => {
  const endDiff = getPeriodEdge(b.period, 'end') - getPeriodEdge(a.period, 'end');
  if (endDiff !== 0) return endDiff;
  return getPeriodEdge(b.period, 'start') - getPeriodEdge(a.period, 'start');
};
const spotlightSlugs = new Set(['whistle-platform', 'acoustic-camera-platform', 'codeharbor']);
const groups = [
  { title: '公司项目', note: '完整索引 · 按最新时间排序', items: projects.filter((p) => p.category === 'company' && !spotlightSlugs.has(p.slug)).sort(compareProjectPeriods) },
  { title: '个人项目', note: '完整索引 · 按最新时间排序', items: projects.filter((p) => p.category === 'personal' && !spotlightSlugs.has(p.slug)).sort(compareProjectPeriods) },
];
const featuredProjects = projects.filter((p) => spotlightSlugs.has(p.slug)).sort(compareProjectPeriods);
const filters = [
  { label: '全部',        value: 'all' },
  { label: '公司项目',    value: 'company' },
  { label: '个人项目',    value: 'personal' },
  { label: 'C++ / Qt',   value: 'cpp-qt' },
  { label: '音频 / 视觉', value: 'audio-vision' },
  { label: 'Electron / Web', value: 'electron-web' },
  { label: 'AI / 工具链', value: 'ai-tools' },
];
const companyFilters = Array.from(new Set(
  projects
    .filter((p) => p.category === 'company' && p.employer)
    .map((p) => p.employer as string),
)).sort((a, b) => {
  const latestStart = (employer: string) => Math.max(
    ...projects
      .filter((p) => p.category === 'company' && p.employer === employer)
      .map((p) => getPeriodEdge(p.period, 'start')),
    0,
  );
  return latestStart(b) - latestStart(a);
});
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<section id="projects" class="projects-section">
  <div class="section-container">

    <!-- Section header -->
    <div class="section-intro">
      <div>
        <span class="section-kicker">SELECTED PROJECTS</span>
        <h2 class="section-title">项目经历</h2>
      </div>
      <p class="intro-note">从设备接入、实时音视频到 Web 全栈与智能工具，展示代表性项目中的职责、方案与交付结果。</p>
    </div>

    <!-- Filters -->
    <div class="project-filters" role="group" aria-label="项目筛选">
      <span class="filter-label" aria-hidden="true">筛选</span>
      {filters.map((f, i) => (
        <button type="button" class:list={['filter-btn', i === 0 && 'is-active']} data-filter={f.value} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label}
        </button>
      ))}
      {companyFilters.length > 0 && (
        <div class="company-filter">
          <details class="company-menu">
            <summary class="company-trigger" aria-label="按任职公司筛选">
              <span data-company-label>按公司</span>
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="company-options" role="listbox" aria-label="选择公司">
              <button type="button" class="company-opt is-selected" data-employer="" role="option" aria-selected="true">全部公司</button>
              {companyFilters.map((c) => (
                <button type="button" class="company-opt" data-employer={c} role="option" aria-selected="false">{c}</button>
              ))}
            </div>
          </details>
        </div>
      )}
      <span class="filter-count" aria-live="polite"></span>
    </div>

    <!-- Featured case studies -->
    <div class="spotlight-heading">
      <div>
        <span class="section-kicker">CASE STUDIES</span>
        <h3>精选案例</h3>
      </div>
      <p>用问题、判断和结果讲清楚代表性项目；其余项目保留为可检索的完整索引。</p>
    </div>
    <div class="project-spotlight">
      {featuredProjects.map((project, index) => (
        <article
          class="spotlight-card"
          data-project-card
          data-category={project.category}
          data-employer={project.employer || ''}
          data-tags={project.tags.join('|').toLowerCase()}
        >
          <div class="spotlight-card-top">
            <span class="spotlight-index">0{index + 1}</span>
            <span class="spotlight-kind">{project.category === 'company' ? 'COMPANY CASE' : 'PERSONAL CASE'}</span>
          </div>
          <h4>{project.name}</h4>
          <p>{project.description}</p>
          <div class="spotlight-result">
            <span>核心结果</span>
            <strong>{project.metrics?.[0]?.value || '完整交付'}</strong>
            <small>{project.metrics?.[0]?.label || project.role || '从方案到发布'}</small>
          </div>
          <div class="spotlight-footer">
            <span>{project.tags.slice(0, 3).join(' · ')}</span>
            <a href={baseUrl + 'projects/' + project.slug} aria-label={`查看 ${project.name} 详情`}>阅读案例 →</a>
          </div>
        </article>
      ))}
    </div>

    <!-- Project groups (two-column layout) -->
    <div class="index-heading">
      <span class="section-kicker">PROJECT INDEX</span>
      <span>完整项目索引</span>
    </div>
    <div class="project-columns">
      {groups.map((group) => (
        <div class="project-group" data-project-group>
          <div class="group-heading">
            <h3>{group.title}</h3>
            <span>{group.note} · <b data-group-count>{group.items.length}</b> 项</span>
          </div>
          <div class="project-list">
            {group.items.map((project, index) => (
              <details
                class:list={['project-entry', project.featured && 'project-entry--featured']}
                name="project-accordion"
                data-category={project.category}
                data-employer={project.employer || ''}
                data-tags={project.tags.join('|').toLowerCase()}
              >
                <summary class="entry-summary">
                  <span class="entry-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  <span class="entry-main">
                    <span class="entry-name">{project.name}</span>
                    <span class="entry-sub">
                      <span class="entry-employer">{project.employer || '个人项目'}</span>
                      <span class="entry-period">{project.period}</span>
                    </span>
                  </span>
                  {/* Show up to 3 tags inline on the row */}
                  <span class="entry-tags" aria-hidden="true">
                    {project.tags.slice(0, 3).map((t) => <span>{t}</span>)}
                  </span>
                  <span class="entry-toggle" aria-hidden="true">
                    <svg class="toggle-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                    </svg>
                  </span>
                </summary>

                <div class="entry-body">
                  <!-- Links -->
                  <div class="entry-links">
                    {project.link && (
                      <a href={project.link} target="_blank" rel="noopener noreferrer" class="entry-link" aria-label={`查看 ${project.name} GitHub 源码`}>
                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                        GitHub
                      </a>
                    )}
                    <a href={baseUrl + 'projects/' + project.slug} class="entry-link" aria-label={`查看 ${project.name} 详情页`}>
                      详情页 →
                    </a>
                  </div>

                  <!-- Description -->
                  <p class="entry-desc">{project.description}</p>

                  <!-- Highlights (max 2) -->
                  {project.highlights.length > 0 && (
                    <ul class="entry-highlights">
                      {project.highlights.slice(0, 2).map((h) => <li>{h}</li>)}
                    </ul>
                  )}

                  <!-- Metrics -->
                  {project.metrics && project.metrics.length > 0 && (
                    <div class="entry-metrics">
                      {project.metrics.map((m) => (
                        <div class="metric-cell">
                          <strong>{m.value}</strong>
                          <span>{m.label}</span>
                        </div>
                      ))}
                    </div>
                  )}

                  <!-- All tags -->
                  <div class="entry-all-tags">
                    {project.tags.map((tag) => (
                      <span class="badge-outline">{tag}</span>
                    ))}
                  </div>
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const entries   = document.querySelectorAll<HTMLDetailsElement>('details.project-entry');
  const cards     = document.querySelectorAll<HTMLElement>('[data-project-card]');
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const companyMenu  = document.querySelector<HTMLDetailsElement>('.company-menu');
  const companyLabel = document.querySelector<HTMLElement>('[data-company-label]');
  const companyOpts  = document.querySelectorAll<HTMLButtonElement>('.company-opt');
  const groups  = document.querySelectorAll<HTMLElement>('[data-project-group]');
  const countEl = document.querySelector<HTMLElement>('.filter-count');

  // Accordion: only one open at a time
  entries.forEach((entry) => {
    entry.addEventListener('toggle', () => {
      if (!entry.open) return;
      entries.forEach((other) => { if (other !== entry) other.open = false; });
    });
  });

  const filterTerms: Record<string, string[]> = {
    'cpp-qt':       ['c++', 'qt', 'c++17', 'c++14', 'c++11'],
    'audio-vision': ['opencv', 'ffmpeg', '音频', '音视频', 'dsp', 'fir/iir', '降噪', '混音', 'prpd', '频谱', '声学', 'tts'],
    'electron-web': ['electron', 'react', 'typescript', 'node.js', 'next.js', 'vue', 'umijs', 'websocket'],
    'ai-tools':     ['ai', 'python', 'fastapi', 'codex cli', 'rag', 'gradio', 'sherpa-onnx', 'tts'],
  };

  const applyFilter = (value: string, employer = '') => {
    let visible = 0;
    entries.forEach((entry) => {
      const cat  = entry.dataset.category || '';
      const emp  = entry.dataset.employer  || '';
      const tags = entry.dataset.tags      || '';
      const match =
        value === 'all'
        || cat === value
        || (employer && emp === employer)
        || (filterTerms[value] || []).some((t) => tags.includes(t));
      entry.hidden = !match;
      if (!match && entry.open) entry.open = false;
      if (match) visible++;
    });
    cards.forEach((card) => {
      const cat  = card.dataset.category || '';
      const emp  = card.dataset.employer  || '';
      const tags = card.dataset.tags      || '';
      const match = value === 'all'
        || cat === value
        || (employer && emp === employer)
        || (filterTerms[value] || []).some((t) => tags.includes(t));
      card.hidden = !match;
      if (match) visible++;
    });
    groups.forEach((g) => {
      const visibles = Array.from(g.querySelectorAll<HTMLDetailsElement>('.project-entry')).filter((e) => !e.hidden);
      g.hidden = visibles.length === 0;
      const cnt = g.querySelector<HTMLElement>('[data-group-count]');
      if (cnt) cnt.textContent = String(visibles.length);
      visibles.forEach((e, i) => {
        const num = e.querySelector<HTMLElement>('.entry-num');
        if (num) num.textContent = String(i + 1).padStart(2, '0');
      });
    });
    filterBtns.forEach((btn) => {
      const active = btn.dataset.filter === value;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', String(active));
    });
    if (countEl) countEl.textContent = `${visible} 项`;
  };

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      companyOpts.forEach((o) => { o.classList.toggle('is-selected', o.dataset.employer === ''); o.setAttribute('aria-selected', String(o.dataset.employer === '')); });
      if (companyLabel) companyLabel.textContent = '按公司';
      if (companyMenu)  companyMenu.open = false;
      applyFilter(btn.dataset.filter || 'all');
    });
  });

  companyOpts.forEach((opt) => {
    opt.addEventListener('click', () => {
      const emp = opt.dataset.employer || '';
      companyOpts.forEach((o) => { o.classList.toggle('is-selected', o === opt); o.setAttribute('aria-selected', String(o === opt)); });
      if (companyLabel) companyLabel.textContent = opt.textContent || '按公司';
      if (companyMenu)  companyMenu.open = false;
      applyFilter('company-filter', emp);
    });
  });

  document.addEventListener('click', (e) => {
    if (companyMenu?.open && e.target instanceof Node && !companyMenu.contains(e.target)) companyMenu.open = false;
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && companyMenu) companyMenu.open = false; });

  applyFilter('all');
</script>

<style>
  /* Section */
  .projects-section { padding: 5rem 0; background: var(--color-bg-secondary); }

  /* Header */
  .section-intro { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; margin-bottom: 2rem; flex-wrap: wrap; }
  .section-intro .section-title { margin-bottom: 0; }
  .intro-note { max-width: 28rem; color: var(--color-text-muted); font-size: .88rem; line-height: 1.7; }

  /* Filters */
  .project-filters { display: flex; align-items: center; flex-wrap: wrap; gap: .4rem .6rem; padding: .75rem 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); margin-bottom: 2rem; }
  .filter-label { font-family: var(--font-mono); font-size: .62rem; font-weight: 600; letter-spacing: .1em; color: var(--color-text-muted); margin-right: .3rem; }
  .filter-btn { padding: .35rem .7rem; border: 1px solid transparent; background: transparent; color: var(--color-text-muted); cursor: pointer; font-size: .78rem; font-weight: 500; border-radius: var(--radius-sm); transition: border-color .18s, color .18s, background-color .18s; }
  .filter-btn:hover { border-color: var(--color-border); color: var(--color-text); }
  .filter-btn.is-active { border-color: var(--color-accent); background: var(--color-accent); color: #fff; }
  .company-filter { position: relative; }
  .company-menu { position: relative; }
  .company-trigger { display: flex; align-items: center; gap: .4rem; padding: .35rem .7rem; border: 1px solid var(--color-border); background: transparent; color: var(--color-text-muted); cursor: pointer; font-size: .78rem; font-weight: 500; border-radius: var(--radius-sm); list-style: none; transition: border-color .18s, color .18s; }
  .company-trigger::-webkit-details-marker { display: none; }
  .company-trigger:hover, .company-menu[open] .company-trigger { border-color: var(--color-accent); color: var(--color-accent); }
  .company-options { position: absolute; z-index: 20; top: calc(100% + .35rem); left: 0; min-width: 13rem; display: grid; gap: .1rem; padding: .35rem; border: 1px solid var(--color-border); background: var(--color-surface); border-radius: var(--radius); box-shadow: var(--shadow-card); }
  .company-opt { display: block; width: 100%; padding: .45rem .6rem; border: 0; background: transparent; color: var(--color-text-muted); cursor: pointer; text-align: left; font-size: .78rem; border-radius: var(--radius-sm); }
  .company-opt:hover, .company-opt.is-selected { background: var(--color-accent); color: #fff; }
  .filter-count { margin-left: auto; color: var(--color-text-muted); font: 500 .68rem var(--font-mono); }

  /* Featured case studies */
  .spotlight-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin: 3rem 0 1rem; }
  .spotlight-heading h3 { margin: .35rem 0 0; color: var(--color-text); font: 700 clamp(1.35rem, 2.5vw, 1.8rem) var(--font-display); letter-spacing: -.04em; }
  .spotlight-heading p { max-width: 28rem; margin: 0; color: var(--color-text-muted); font-size: .78rem; line-height: 1.7; }
  .project-spotlight { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); }
  .spotlight-card { display: flex; min-height: 22rem; flex-direction: column; padding: 1.35rem; background: var(--color-surface); transition: background-color .2s, transform .2s; }
  .spotlight-card:hover { position: relative; z-index: 1; background: var(--color-accent-soft); transform: translateY(-3px); }
  .spotlight-card[hidden] { display: none; }
  .spotlight-card-top, .spotlight-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .spotlight-index { color: var(--color-marker); font: 600 .72rem var(--font-mono); }
  .spotlight-kind { color: var(--color-text-muted); font: 500 .58rem var(--font-mono); letter-spacing: .1em; }
  .spotlight-card h4 { max-width: 13ch; margin: 3.2rem 0 .8rem; color: var(--color-text); font: 700 1.35rem/1.18 var(--font-display); letter-spacing: -.04em; }
  .spotlight-card > p { margin: 0; color: var(--color-text-muted); font-size: .78rem; line-height: 1.7; }
  .spotlight-result { display: grid; gap: .22rem; margin-top: auto; padding: 1rem 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .spotlight-result span { color: var(--color-accent); font: 500 .6rem var(--font-mono); letter-spacing: .1em; }
  .spotlight-result strong { color: var(--color-text); font: 650 1.05rem var(--font-display); }
  .spotlight-result small { color: var(--color-text-muted); font-size: .68rem; }
  .spotlight-footer { padding-top: 1rem; color: var(--color-text-muted); font: 500 .62rem var(--font-mono); }
  .spotlight-footer a { color: var(--color-accent); white-space: nowrap; }
  .spotlight-footer a:hover { color: var(--color-text); }

  .index-heading { display: flex; align-items: center; gap: .85rem; margin: 3.5rem 0 1rem; padding-bottom: .7rem; border-bottom: 1px solid var(--color-border); }
  .index-heading > span:last-child { color: var(--color-text-muted); font-size: .78rem; }

  /* Columns */
  .project-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; align-items: start; }
  .project-columns > .project-group + .project-group { margin-top: 0; }

  /* Group heading */
  .group-heading { display: flex; align-items: baseline; gap: .7rem; border-bottom: 2px solid var(--color-accent); padding-bottom: .7rem; margin-bottom: 0; }
  .group-heading h3 { font: 700 1.1rem var(--font-display); color: var(--color-text); letter-spacing: -.03em; margin: 0; }
  .group-heading span { color: var(--color-text-muted); font-size: .72rem; }
  .group-heading b { color: var(--color-accent); }

  /* Project list */
  .project-list { display: block; }

  /* Entry (accordion) */
  .project-entry { border-bottom: 1px solid var(--color-border); }
  .project-entry[hidden], .project-group[hidden] { display: none; }
  .project-entry[open] { border-bottom-color: var(--color-accent); }

  /* Featured: orange top accent */
  .project-entry--featured > .entry-summary { border-left: 3px solid var(--color-marker); padding-left: calc(.9rem - 3px); }
  .project-entry--featured .entry-num { color: var(--color-marker); }
  .project-entry--featured .entry-name { color: var(--color-text); }

  /* Summary row */
  .entry-summary { display: grid; grid-template-columns: 2rem 1fr auto auto; gap: .65rem; align-items: center; min-height: 5.5rem; padding: .9rem 0; cursor: pointer; list-style: none; position: relative; transition: background-color .18s; }
  .entry-summary::-webkit-details-marker { display: none; }

  /* Left accent bar */
  .entry-summary::before { content: ''; position: absolute; left: -.9rem; top: 0; bottom: 0; width: 3px; background: var(--color-accent); transform: scaleY(0); transform-origin: center; transition: transform .2s ease; border-radius: 2px; }
  .entry-summary:hover::before, .project-entry[open] .entry-summary::before { transform: scaleY(1); }

  .entry-num { align-self: start; padding-top: .1rem; color: var(--color-accent); font: 500 .72rem var(--font-mono); letter-spacing: .06em; }
  .entry-main { min-width: 0; display: grid; gap: .25rem; }
  .entry-name { font: 600 1rem var(--font-display); color: var(--color-text); letter-spacing: -.025em; line-height: 1.3; }
  .entry-sub { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .entry-employer { font: 500 .68rem var(--font-mono); color: var(--color-text-muted); }
  .entry-period { font: 500 .65rem var(--font-mono); color: var(--color-accent); }

  /* Inline tag preview */
  .entry-tags { display: flex; gap: .3rem; flex-wrap: nowrap; overflow: hidden; max-width: 8rem; }
  .entry-tags span { font: 500 .62rem var(--font-mono); color: var(--color-text-muted); white-space: nowrap; }
  .entry-tags span:not(:last-child)::after { content: ' /'; color: var(--color-border); margin-left: .2rem; }

  /* Toggle icon */
  .entry-toggle { display: flex; align-items: center; justify-content: center; width: 1.6rem; height: 1.6rem; border: 1px solid var(--color-border); border-radius: 50%; color: var(--color-text-muted); flex-shrink: 0; transition: border-color .18s, color .18s, transform .2s; }
  .toggle-icon { width: .85rem; height: .85rem; transition: transform .2s ease; }
  .project-entry[open] .entry-toggle { border-color: var(--color-accent); color: var(--color-accent); background: var(--color-accent-soft); }
