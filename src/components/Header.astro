---
import ThemeToggle from './ThemeToggle';
---

<header class="sticky top-4 z-50">
  <nav class="section-container">
    <div class="nav-shell">
      <a
        href={import.meta.env.BASE_URL}
        class="brand-mark"
      >
        <span class="brand-glyph">LY</span>
        <span class="brand-copy"><strong>LIU YUANLONG</strong><small>SOFTWARE / PRODUCT / FORM</small></span>
      </a>

      <div class="flex items-center gap-4">
        <ul class="hidden sm:flex items-center gap-6">
          <li>
            <a href="#about" class="nav-link">
              关于
            </a>
          </li>
          <li>
            <a href="#experience" class="nav-link">
              经历
            </a>
          </li>
          <li>
            <a href="#projects" class="nav-link">
              项目
            </a>
          </li>
          <li>
            <a href="#skills" class="nav-link">
              技能
            </a>
          </li>
        </ul>

        <ThemeToggle client:load />
      </div>
    </div>
  </nav>
</header>

<style>
  .brand-mark { display: inline-flex; align-items: center; gap: .7rem; }
  .brand-glyph { display: grid; place-items: center; width: 2.1rem; height: 2.1rem; background: var(--color-text); color: var(--color-bg); font: 800 .78rem var(--font-mono); border: 2px solid var(--color-text); }
  .brand-copy { display: grid; gap: .05rem; line-height: 1; }
  .brand-copy strong { font: 700 .78rem var(--font-mono); letter-spacing: .08em; }
  .brand-copy small { color: var(--color-text-secondary); font: 500 .52rem var(--font-mono); letter-spacing: .12em; }
</style>
