---
import ThemeToggle from './ThemeToggle';
---

<header class="site-header">
  <nav class="section-container">
    <div class="nav-shell">
      <a
        href={import.meta.env.BASE_URL}
        class="brand-mark"
        aria-label="返回首页"
      >
        <span class="brand-glyph" aria-hidden="true">LY</span>
        <span class="brand-name">刘元龙</span>
      </a>

      <div class="flex items-center gap-5">
        <ul class="hidden sm:flex items-center gap-7" role="list">
          <li><a href="#about"      class="nav-link">关于</a></li>
          <li><a href="#experience" class="nav-link">经历</a></li>
          <li><a href="#projects"   class="nav-link">项目</a></li>
          <li><a href="#skills"     class="nav-link">技能</a></li>
        </ul>

        <ThemeToggle client:load />
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav-shell {
    padding: .75rem 0;
  }

  /* Brand */
  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    text-decoration: none;
  }

  .brand-glyph {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: var(--color-accent);
    color: #fff;
    font: 700 .7rem var(--font-mono);
    letter-spacing: .05em;
    border-radius: var(--radius);
    flex-shrink: 0;
  }

  .brand-name {
    font: 600 .88rem var(--font-display);
    color: var(--color-text);
    letter-spacing: -.01em;
  }

  /* Nav links */
  .nav-link {
    color: var(--color-text-muted);
    font-size: .84rem;
    font-weight: 500;
    transition: color 0.18s ease;
    letter-spacing: -.01em;
  }

  .nav-link:hover {
    color: var(--color-text);
  }
</style>
