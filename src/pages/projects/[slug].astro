---
export const prerender = false;

import { marked } from 'marked';
import type { Project, SiteConfig } from '../../types/resume';
import Layout from '../../layouts/Layout.astro';
import ImageGallery from '../../components/projects/ImageGallery';
import CommitHistory from '../../components/projects/CommitHistory.astro';
import ProjectArchitecture from '../../components/projects/ProjectArchitecture.astro';
import ProjectCaseNotes from '../../components/projects/ProjectCaseNotes.astro';
import { fetchMeta, fetchPublishedResume } from '../../lib/api';
import { normalizeResume } from '../../lib/normalizeResume';
import { prepareProjectAnalysis } from '../../lib/presentationText';

const assetBaseUrl = import.meta.env.BASE_URL;
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const analysisModules = import.meta.glob('../../data/project-analysis/*.md', {
  eager: true,
  query: '?raw',
  import: 'default'
}) as Record<string, string>;

const analysisBySlug = Object.fromEntries(
  Object.entries(analysisModules).map(([file, content]) => [
    file.split('/').pop()?.replace(/\.md$/, '') || '',
    content
  ])
);

function selectInlineAnalysis(markdown: string) {
  const sections = markdown
    .replace(/^# .*\n\n/, '')
    .split(/(?=^## \d+\.)/gm)
    .filter((section) => section.startsWith('## '));
  const keep = ['## 02.', '## 03.', '## 05.'];
  return sections.filter((section) => keep.some((heading) => section.startsWith(heading))).join('\n');
}

const fallbackSite: SiteConfig = {
  title: 'Resume',
  description: 'Resume not published yet.',
  theme: 'auto',
  language: 'en'
};

let project: Project | null = null;
let site: SiteConfig = fallbackSite;
let errorMessage: string | null = null;
let profileName = '';
let meta = {
  appVersion: '',
  opsVersion: ''
};

try {
  const data = await fetchPublishedResume();
  if (!data) {
    errorMessage = 'Resume not published.';
    Astro.response.status = 404;
  } else {
    const resume = normalizeResume(data.resume, assetBaseUrl);
    site = resume.site;
    profileName = resume.profile?.name?.trim() || '';
    project = resume.projects.find((item) => item.slug === Astro.params.slug) || null;
    if (!project) {
      errorMessage = 'Project not found.';
      Astro.response.status = 404;
    }
  }
} catch (error) {
  errorMessage = error instanceof Error ? error.message : 'Unable to load project.';
  Astro.response.status = 500;
}

const metaPayload = await fetchMeta();
if (metaPayload) {
  meta = metaPayload;
}

const detailHtml = project?.detail ? marked(project.detail) : '';
const inlineAnalysisMarkdown = project ? selectInlineAnalysis(analysisBySlug[project.slug] || '') : '';
const inlineAnalysisHtml = inlineAnalysisMarkdown ? marked(prepareProjectAnalysis(inlineAnalysisMarkdown)) : '';
const siteTitle = site.title?.trim() || '';
const autoTitle = profileName ? `${profileName}的简历` : siteTitle || fallbackSite.title;
const pageTitle = siteTitle && !siteTitle.includes('个人主页') ? siteTitle : autoTitle;
---

<Layout
  title={project ? `${project.name} - ${pageTitle}` : pageTitle}
  description={project?.description || site.description}
  language={site.language}
  meta={meta}
>
  {!project && (
    <section class="py-16">
      <div class="section-container">
        <div class="card text-center">
          <h1 class="text-2xl font-bold mb-2">项目不可用</h1>
          <p style="color: var(--color-text-secondary);">{errorMessage}</p>
          <a
            href={baseUrl}
            class="inline-flex items-center gap-2 text-sm mt-6 link"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            返回首页
          </a>
        </div>
      </div>
    </section>
  )}

  {project && (
    <article class="project-detail-page py-12">
      <div class="section-container">
        <!-- Back Link -->
        <a
          href={`${baseUrl}#projects`}
          class="inline-flex items-center gap-2 text-sm mb-8 link"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          返回首页
        </a>

        <!-- Header -->
        <header class="project-detail-header mb-8">
          <div class="project-header-kicker">
            <p class="section-kicker">{project.category === 'company' ? 'COMPANY CASE / PROJECT' : 'PERSONAL CASE / PROJECT'}</p>
            <span class="case-index">PROJECT PROFILE · {project.category === 'company' ? 'COMPANY' : 'PERSONAL'}</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-semibold mb-4">{project.name}</h1>

          <div class="flex flex-wrap items-center gap-4 text-sm" style="color: var(--color-text-secondary);">
            {project.employer && (
              <span class="project-employer">{project.employer}</span>
            )}
            {project.role && (
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                {project.role}
              </span>
            )}
            {project.period && (
              <span class="flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                {project.period}
              </span>
            )}
            {project.link && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1 link"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
                查看源码
              </a>
            )}
          </div>
        </header>

        <section class="project-facts" aria-label="项目速览">
          <div class="project-fact">
            <span>归属</span>
            <strong>{project.category === 'company' ? '公司项目' : '个人项目'}</strong>
            <small>{project.employer || '独立开发'}</small>
          </div>
          <div class="project-fact">
            <span>周期</span>
            <strong>{project.period || '—'}</strong>
            <small>{project.role || '项目开发'}</small>
          </div>
          <div class="project-fact project-fact-wide">
            <span>核心技术</span>
            <div class="project-fact-tags">
              {project.tags.slice(0, 6).map((tag) => <span>{tag}</span>)}
            </div>
          </div>
          {project.metrics?.slice(0, 1).map((metric) => (
            <div class="project-fact project-fact-result">
              <span>关键结果</span>
              <strong>{metric.value}</strong>
              <small>{metric.label}</small>
            </div>
          ))}
        </section>

        <div class="reading-mode-switch" aria-label="详情阅读模式">
          <span class="reading-mode-label">READING MODE / <b>详细内容</b></span>
          <button type="button" class="reading-mode-button" aria-pressed="false">切换为重点摘要</button>
        </div>

        <!-- Project Brief -->
        <section class="project-intro mb-10" aria-label="项目摘要">
          <div class="project-intro-heading">
            <span class="project-intro-kicker">PROJECT OVERVIEW / BUSINESS VALUE</span>
            <h2>项目价值与交付范围</h2>
          </div>
          <p class="text-lg" style="color: var(--color-text-secondary);">
            {project.description}
          </p>
          <div class="project-intro-line"></div>
          <p class="project-intro-label">PROJECT VALUE / ENGINEERING DELIVERY</p>
        </section>

        <!-- Architecture and contribution -->
        <ProjectArchitecture project={project} />
        <ProjectCaseNotes project={project} />

        <!-- Source-backed visual evidence -->
        {project.images && project.images.length > 0 && (
          <section class="project-visual-evidence full-mode-section mb-12" aria-label="源码图解与流程证据">
            <div class="project-section-heading">
              <div>
                <span class="project-intro-kicker">SYSTEM FLOW / VISUAL EVIDENCE</span>
                <h2>系统流程与界面证据</h2>
              </div>
              <span class="project-section-note">ARCHITECTURE / FLOW / DECISIONS</span>
            </div>
            <ImageGallery images={project.images} client:load />
          </section>
        )}

        <!-- Inline source analysis; intentionally excludes content already covered above and below. -->
        {inlineAnalysisHtml && (
          <section class="project-analysis-inline full-mode-section mb-12" aria-label="技术实现与工程实践">
            <div class="project-section-heading">
              <div>
                <span class="project-intro-kicker">ENGINEERING IMPLEMENTATION / PRACTICE</span>
                <h2>技术实现与工程实践</h2>
              </div>
              <span class="project-section-note">SCAN / STACK / FLOW</span>
            </div>
            <div class="analysis-inline-prose" set:html={inlineAnalysisHtml} />
          </section>
        )}

        {inlineAnalysisHtml && (
          <script is:inline type="module">
            import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
            mermaid.initialize({
              startOnLoad: false,
              theme: 'base',
              securityLevel: 'strict',
              themeVariables: {
                primaryColor: '#eef4ff',
                primaryTextColor: '#141a21',
                primaryBorderColor: '#2f6df6',
                lineColor: '#52606d',
                secondaryColor: '#f6f7f9',
                tertiaryColor: '#ffffff',
                fontFamily: 'Space Grotesk, sans-serif'
              }
            });
            await mermaid.run({ querySelector: '.analysis-inline-prose pre code.language-mermaid' });
          </script>
        )}

        <!-- Detail Content (Markdown) -->
        {detailHtml && (
          <section class="full-mode-section mb-12">
            <div class="prose prose-lg dark:prose-invert max-w-none" set:html={detailHtml} />
          </section>
        )}

        <!-- Git Commits -->
        {project.commits && project.commits.length > 0 && (
          <section class="full-mode-section mb-12">
            <h2 class="text-xl font-semibold mb-4">代码提交规范</h2>
            <CommitHistory commits={project.commits} />
          </section>
        )}

        <!-- Footer Link -->
        {project.link && (
          <div class="pt-8 border-t" style="border-color: var(--color-border);">
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              在 GitHub 上查看
            </a>
          </div>
        )}
      </div>
    </article>
  )}
</Layout>

<script>
  const readingModeButton = document.querySelector<HTMLButtonElement>('.reading-mode-button');
  const readingModeLabel = document.querySelector<HTMLElement>('.reading-mode-label b');
  const projectDetailPage = document.querySelector<HTMLElement>('.project-detail-page');
  readingModeButton?.addEventListener('click', () => {
    const interviewMode = projectDetailPage?.classList.toggle('interview-mode') || false;
    readingModeButton.setAttribute('aria-pressed', String(interviewMode));
    readingModeButton.textContent = interviewMode ? '切换为详细内容' : '切换为重点摘要';
    if (readingModeLabel) readingModeLabel.textContent = interviewMode ? '重点摘要' : '详细内容';
  });
</script>

<style is:global>
  .project-detail-header {
    position: relative;
    padding: 2.5rem 2.25rem 2rem;
    border: 1px solid var(--color-border);
    border-radius: .45rem;
    overflow: hidden;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-primary), transparent 94%), transparent 55%),
      linear-gradient(var(--color-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px),
      var(--color-bg-secondary);
    background-size: auto, 30px 30px, 30px 30px, auto;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.45), 0 18px 50px rgba(0, 38, 48, .07);
  }

  .project-detail-header::after {
    content: '';
    position: absolute;
    right: -5rem;
    top: -6rem;
    width: 15rem;
    height: 15rem;
    border: 1px solid color-mix(in srgb, var(--color-primary), transparent 55%);
    border-radius: 50%;
    box-shadow: 0 0 0 1.5rem color-mix(in srgb, var(--color-primary), transparent 94%);
    pointer-events: none;
  }

  .project-header-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .case-index,
  .project-intro-label,
  .metric-detail-index {
    color: var(--color-primary);
    font: 500 .64rem var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .project-detail-header h1 {
    position: relative;
    z-index: 1;
    max-width: 16ch;
    font-weight: 800;
  }

  .project-facts {
    display: grid;
    grid-template-columns: minmax(8rem, .75fr) minmax(10rem, 1fr) minmax(16rem, 1.8fr) minmax(8rem, .75fr);
    margin: -1px 0 3.5rem;
    border-top: 1px solid var(--color-primary);
    border-bottom: 1px solid var(--color-border);
  }

  .project-fact {
    display: grid;
    align-content: start;
    gap: .35rem;
    min-height: 6.6rem;
    padding: 1rem 1.1rem;
    border-right: 1px solid var(--color-border);
  }

  .project-fact:last-child { border-right: 0; }
  .project-fact > span { color: var(--color-accent); font: 500 .6rem var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
  .project-fact strong { color: var(--color-text); font: 650 .92rem var(--font-display); line-height: 1.35; }
  .project-fact small { color: var(--color-text-secondary); font-size: .72rem; line-height: 1.45; }
  .project-fact-wide { min-width: 0; }
  .project-fact-tags { display: flex; flex-wrap: wrap; gap: .35rem .65rem; }
  .project-fact-tags span { color: var(--color-text-secondary); font: 500 .68rem var(--font-mono); }
  .project-fact-tags span:not(:last-child)::after { content: ' /'; margin-left: .55rem; color: var(--color-border); }
  .project-fact-result strong { color: var(--color-accent); font-size: 1.15rem; }

  .reading-mode-switch { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin: -2rem 0 3rem; padding: .65rem 0; border-bottom: 1px solid var(--color-border); }
  .reading-mode-label { color: var(--color-text-secondary); font: 500 .62rem var(--font-mono); letter-spacing: .1em; }
  .reading-mode-label b { color: var(--color-primary); font-weight: 500; }
  .reading-mode-button { padding: .45rem .7rem; border: 1px solid var(--color-border); background: transparent; color: var(--color-primary); cursor: pointer; font: 500 .68rem var(--font-mono); }
  .reading-mode-button:hover, .reading-mode-button:focus-visible { border-color: var(--color-accent); color: var(--color-accent); outline: none; }
  .project-detail-page.interview-mode .full-mode-section { display: none; }

  .project-employer {
    color: var(--color-text);
    font: 600 .72rem var(--font-mono);
  }

  .project-intro {
    max-width: 54rem;
  }

  .project-intro-heading,
  .project-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .project-intro-heading h2,
  .project-section-heading h2 {
    margin: .45rem 0 0;
    color: var(--color-text);
    font: 700 clamp(1.35rem, 2.6vw, 1.9rem) var(--font-display);
    letter-spacing: -.03em;
  }

  .project-intro-kicker,
  .project-section-note {
    color: var(--color-primary);
    font: 500 .62rem var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .project-section-note {
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .project-visual-evidence {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .project-analysis-inline {
    padding: 1.35rem 1.5rem 1.5rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    background: var(--color-bg-secondary);
  }

  .analysis-inline-prose {
    max-width: 54rem;
  }

  .analysis-inline-prose h2 {
    margin: 1.8rem 0 .75rem;
    color: var(--color-text);
    font: 700 1.25rem var(--font-display);
  }

  .analysis-inline-prose h3 {
    margin: 1.25rem 0 .5rem;
    color: var(--color-text);
    font: 650 1rem var(--font-display);
  }

  .analysis-inline-prose p,
  .analysis-inline-prose li {
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .analysis-inline-prose ul,
  .analysis-inline-prose ol {
    padding-left: 1.25rem;
  }

  .analysis-inline-prose pre {
    margin: 1rem 0;
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: inset 3px 0 0 var(--color-accent);
  }

  .analysis-inline-prose code {
    color: var(--color-primary);
    font-family: var(--font-mono);
  }

  .analysis-inline-prose pre code { color: var(--color-text); }
  .analysis-inline-prose pre.mermaid { display: grid; place-items: center; min-height: 9rem; }
  .analysis-inline-prose pre.mermaid svg { max-width: 100%; height: auto; }

  .project-intro p:first-child {
    max-width: 48rem;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.7;
  }

  .project-intro-line {
    width: 4rem;
    height: 2px;
    margin: 1.5rem 0 .65rem;
    background: var(--color-accent);
  }

  @media (max-width: 640px) {
    .project-intro-heading,
    .project-section-heading {
      display: block;
    }

    .project-section-note {
      display: block;
      margin-top: .55rem;
    }

    .project-analysis-inline {
      padding: 1rem;
    }
  }

  .subsection-heading {
    display: flex;
    align-items: baseline;
    gap: .9rem;
    margin-bottom: 1.1rem;
  }

  .subsection-heading h2 {
    margin: 0;
    font: 700 1.35rem var(--font-display);
  }

  .metric-detail-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .75rem;
  }

  .metric-detail-card {
    display: grid;
    gap: .45rem;
    min-height: 7.5rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-primary);
    background: var(--color-bg-secondary);
  }

  .metric-detail-card strong {
    color: var(--color-text);
    font: 700 1rem var(--font-display);
    line-height: 1.35;
  }

  .metric-detail-card > span:last-child {
    color: var(--color-text-secondary);
    font-size: .72rem;
  }

  .contribution-card {
    display: flex;
    align-items: flex-start;
    gap: .8rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    color: var(--color-text-secondary);
    font-size: .88rem;
    line-height: 1.65;
  }

  .contribution-index {
    flex: 0 0 auto;
    color: var(--color-accent);
    font: 600 .7rem var(--font-mono);
  }

  .project-stack {
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-secondary), transparent 12%);
  }

  .project-stack .subsection-heading {
    margin-bottom: .85rem;
  }

  /* Prose styles for markdown content */
  .prose {
    color: var(--color-text);
    font-family: var(--font-body);
  }

  .prose h2 {
    color: var(--color-text);
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-display);
  }

  .prose {
    max-width: 52rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .prose::before {
    content: 'CASE NOTES / ENGINEERING DETAIL';
    display: block;
    color: var(--color-primary);
    font: 500 .64rem var(--font-mono);
    letter-spacing: .14em;
    margin-bottom: 1.5rem;
  }

  .prose h3 {
    color: var(--color-text);
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-family: var(--font-display);
  }

  .prose p {
    margin-bottom: 1rem;
    line-height: 1.75;
  }

  .prose ul,
  .prose ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .prose code {
