---
import Layout from '../layouts/Layout.astro';

type InterviewQuestion = {
  question: string;
  focus: string;
  answer: string;
  followUps?: string[];
};

type InterviewSection = {
  title: string;
  note: string;
  questions: InterviewQuestion[];
};

const sections: InterviewSection[] = [
  {
    title: '开场与职业定位',
    note: '先让面试官快速理解你的技术边界、工作范围与求职方向',
    questions: [
      {
        question: '请做一个 2 分钟左右的自我介绍',
        focus: '考察表达结构、岗位匹配度和代表性成果',
        answer: '您好，我是刘元龙，有近十年软件开发经验，主要方向是 C++/Qt 跨平台桌面软件、音频与设备软件，同时具备 Electron、React/Vue、Node.js 和 Python 的全栈开发经验。最近的工作聚焦在声学监控、声学成像、音频播报和多端设备管理，参与过从设备接入、实时音视频处理、算法结果展示到 Web 管理和跨平台发布的完整链路。我的优势是能在设备、算法、桌面 UI 和 Web 服务之间建立清晰的边界，并通过队列、时间戳、协议状态和可诊断机制解决现场问题。此前我还做过 Qt 图形组态、AR 图像识别跟踪和即时通讯客户端。希望下一步继续在高级 C++/Qt、跨平台桌面、音频设备或实时系统方向承担更完整的技术职责，同时发挥全栈能力。',
      },
      {
        question: '你的核心竞争力是什么？为什么不仅仅是 C++/Qt 开发？',
        focus: '考察是否能把“技术栈罗列”转化为业务价值',
        answer: '我的核心竞争力是跨边界解决问题。C++/Qt 是我最深的主线，能够处理桌面应用、设备协议、实时数据和性能问题；但实际项目中，产品还需要 Web 管理端、Electron 工作台、API、部署和诊断工具，所以我也使用 React/Vue、TypeScript、Node.js、Docker 和 CI 把前后端及交付链路补齐。比如设备端输出的状态和算法结果，不能只停留在 C++ 日志里，我会通过 WebSocket、HTTP 或 SSE 暴露给管理端，并配套可复现的测试工具。这样我的价值不只是完成一个模块，而是把设备能力稳定地交付成可使用、可排障的产品。',
      },
    ],
  },
  {
    title: 'Whistle：实时声学监控平台',
    note: '围绕实时管线、证据闭环、设备可靠性和跨平台交付展开追问',
    questions: [
      {
        question: '请介绍 Whistle 的整体架构和你负责的部分',
        focus: '考察能否从系统层面说明模块边界，而不是只描述文件名',
        answer: 'Whistle 是连接麦克风阵列、摄像头、声音识别、声源定位、车牌识别、证据生成和上报通道的跨平台 C++ 系统。整体按实时数据边界分为数据预处理、鸣笛识别和鸣笛处理三段：接收侧负责解码、分帧、时间戳和缓存；识别侧从处理单元队列取数据，产出事件和定位结果；处理侧根据事件时间窗查询视频帧，串联车牌识别、证据生成和 Reporter 上报。我参与音频接收、音视频同步、识别和取证链路，参与 Qt6/QML 工作台及 WebSocket 状态通道，也参与 CMake、vcpkg、Docker 和 GitLab CI 的跨平台构建发布。',
        followUps: ['为什么要拆成多个队列？', '哪些模块可以独立测试或离线回放？'],
      },
      {
        question: '实时音频管线为什么使用固定帧和有界队列？如何处理背压？',
        focus: '考察并发模型、实时性和资源边界意识',
        answer: '音频按固定大小的帧进入处理链路，可以让识别、定位和缓存拥有稳定的时间粒度，也便于用 PTS 或时间戳对齐音频和视频。有界队列的作用是限制内存增长，避免下游算法或设备异常时无限堆积。实现上需要明确生产者和消费者的生命周期、队列满时的策略以及丢帧是否可接受：实时预览通常优先保留最新数据，证据链路则需要保留事件窗口并保证完整性。我的处理原则是把接收线程和算法线程隔离，记录队列长度、处理延迟和丢弃原因，并对短事件、长事件分别设置合适的取证时间窗口。',
      },
      {
        question: '项目中的证据生成如何避免音视频截断或时间错位？',
        focus: '考察时间窗口、异步任务和可靠交付设计',
        answer: '证据生成不是事件一触发就立即读取一帧，而是先记录事件时间和任务参数，再等待完整的预录制和总时长窗口。EvidenceTaskExecutor 根据时间窗从音视频存储取数，使用统一时间戳选择相邻帧和音频片段，随后生成图片、视频、原始音频和违法记录。任务侧还需要做重复任务判断、限流、阈值控制和状态持久化；如果上报网络暂时失败，就把任务转为可恢复的补传状态，而不是把网络错误直接等同于现场证据丢失。',
      },
      {
        question: '你提到排查过麦克风阵列偶发离线，具体是怎么定位的？',
        focus: '考察复杂问题排查、跨设备边界和根因思维',
        answer: '表面现象是应用重连失败，最初很容易通过重启规避。我的排查过程是先对比应用日志、UDP 收发行为和设备状态变化，缩小问题发生在设备网络事件处理而不是单纯的 Qt 连接层；再结合固件事件循环检查，定位到 XMOS 固件中的 UDP 反射逻辑存在忙等，阻塞了 uIP 事件循环，导致后续网络事件不能持续处理。最终推动从增加重启次数转为固件侧修复，并在上层保留协议探测、重试和状态可视化。这类问题的关键是沿着完整链路收集证据，而不是只在最靠近用户的层面加重试。',
      },
      {
        question: '第三方车牌识别组件存在单进程单路限制，你们如何扩展吞吐？',
        focus: '考察受限组件下的架构权衡和工程落地能力',
        answer: '我们没有把所有路数都压到同一个进程里，而是将识别能力拆成多个进程实例，通过进程间消息和共享内存传递图像与结构化结果。这样可以绕开第三方组件的单路限制，也能把单路崩溃、超时和资源占用隔离开。调度侧需要维护实例状态、任务超时和识别失败原因，不能只做简单轮询；同时要评估进程数量、GPU/CPU 资源和现场部署复杂度。这个方案的取舍是增加了进程管理和诊断成本，但换来了吞吐扩展与故障隔离。',
      },
    ],
  },
  {
    title: '性能、并发与 C++ 工程能力',
    note: '重点准备面试官可能从项目细节下钻到语言和工程基础的问题',
    questions: [
      {
        question: '如果一个 C++ 实时模块出现偶发崩溃，你会如何排查？',
        focus: '考察排障流程，而不是只看是否会使用某个工具',
        answer: '我会先把问题分成内存生命周期、线程同步、输入边界和外部依赖四类，并尽量保留现场上下文。第一步确认崩溃栈、线程状态、版本和触发条件；第二步用 ASan/UBSan、core dump、日志 trace 或最小复现缩小范围；第三步检查所有权是否明确，尤其是跨线程传递的 buffer、QObject 生命周期和回调捕获；第四步验证修复是否破坏实时性或协议时序。对设备问题还会同时抓取协议包和状态机日志。修复后补充回归用例或离线样本，避免只修复一次现场现象。',
      },
      {
        question: '你如何设计线程之间的数据所有权和生命周期？',
        focus: '考察 RAII、并发安全和可维护性',
        answer: '我会先定义数据由谁创建、谁消费、谁销毁，再决定使用值语义、移动语义、智能指针还是固定缓冲区。实时链路尽量避免不受控的频繁分配，使用固定帧或可复用 buffer；跨线程传递时通过队列转移清晰的所有权，避免多个线程同时修改同一对象。共享状态则用明确的锁、原子变量或消息传递，不把“加一把大锁”作为默认方案。对于 Qt 对象，还会遵守线程归属和 queued connection 规则，关闭时先停止生产者，再排空或取消消费者，最后释放资源。',
      },
      {
        question: '你在 CMake、vcpkg、Docker 和 CI 中分别解决了什么问题？',
        focus: '考察工程化能力和跨平台交付经验',
        answer: 'CMake 负责目标、编译选项和平台差异的统一描述；vcpkg 固定和复用第三方依赖，减少开发机环境差异；Docker 把 Linux 构建和依赖环境固化，便于复现；GitLab CI 则把编译、测试、打包和产物留存串成可重复流程。跨平台项目中，我会尽量把平台差异收敛在少量 adapter 或 CMake 条件里，避免业务代码到处出现操作系统分支。发布失败时先区分源码问题、依赖问题、工具链问题和打包问题，并通过最小构建或 smoke test 快速定位。',
      },
      {
        question: '你如何理解 Qt 中模型、视图和业务状态的边界？',
        focus: '考察桌面 UI 架构、状态同步和长期维护能力',
        answer: '业务状态不应该散落在控件事件里。设备连接、配置、算法结果和任务状态应由业务层或状态模型统一持有，Qt/QML 或 Widgets 只负责展示和交互，通过信号、模型或明确的 command 更新状态。对于 Qt Graphics 或 QML，我会把对象模型、属性面板、选择移动和状态同步拆开，避免图元既负责渲染又负责所有业务逻辑。这样做可以让离线测试、状态回放和后续替换 UI 技术栈更容易。',
      },
    ],
  },
  {
    title: '音频、视觉与设备软件',
    note: '用具体技术难点说明你对音频链路、图像算法和硬件交互的理解',
    questions: [
      {
        question: 'Acoustic Camera 中 CUDA 优化是如何确认收益的？',
        focus: '考察性能优化是否有基准、定位和验证过程',
        answer: '我会先用实际输入建立基线，区分矩阵生成、定位矩阵移动、归一化以及同步等待分别耗时多少，再针对热点做优化，而不是只凭感觉改 CUDA kernel。项目中声源图矩阵生成约从 35ms 降到 16ms，定位矩阵移动约从 25ms 降到 3ms，归一化约从 30ms 降到 4ms；同时清理了不必要的 cudaDeviceSynchronize，减少 CPU/GPU 间的同步开销。验证时还要检查结果误差、不同输入规模、显存生命周期和无 CUDA 环境下的降级路径，确保性能收益没有换来算法结果或设备稳定性问题。',
      },
      {
        question: 'OpenCV 的 ORB 识别跟踪优化主要从哪些方向入手？',
        focus: '考察图像算法优化的实际方法',
        answer: '在 AR SDK 中，我从采集图像预处理和 ORB 特征提取参数两侧入手。预处理要尽量提升有效特征的稳定性并抑制噪声，ORB 参数则需要结合图书页面的纹理、尺度变化和采集质量调整特征点数量、尺度金字塔等配置。验证不能只看某一张样本，而要观察不同光照、角度、模糊和遮挡条件下的识别成功率与跟踪连续性，同时关注计算量和误识别率，最后通过回放样本做回归。',
      },
      {
        question: '音频播报服务为什么同时设计 HTTP 和 TCP？',
        focus: '考察协议分层和设备服务设计',
        answer: 'HTTP 更适合给 Web 管理端或业务系统提供清晰的控制 API，例如播报、停止、音量和状态查询；TCP 更适合与现场音频终端维持设备协议会话。服务内部应把 HTTP handler、TCP session、TTS 引擎、播放队列和设备协议拆成不同边界，让多个入口最终汇聚到统一的播放控制模型。这样既能支持 Windows TTS 和本地 sherpa-onnx/Kokoro 等引擎，也能通过 TCP tester、SSE 日志和 Web 管理页分别验证协议、引擎和运行状态。',
      },
    ],
  },
  {
    title: 'Electron、Web 与全栈协作',
    note: '重点准备“为什么做全栈”和“如何与设备端协作”的追问',
